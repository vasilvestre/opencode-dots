[Unit]
Description=Circuit breaker: drop a repository to act after a bad merge by the dot

[Service]
Type=oneshot
WorkingDirectory=%h/projects/perso/opencode-dots
Environment=STATE_DIR=%h/projects/perso/opencode-dots/state
# DOT_LOGIN (the dot's GitHub login) and the gh token come from .env.
EnvironmentFile=-%h/projects/perso/opencode-dots/.env
# breaker.list is generated by `make repos`; see docs/breaker.md.
ExecStart=%h/projects/perso/opencode-dots/bin/breaker check-all
