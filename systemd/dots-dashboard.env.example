# Copy to systemd/dots-dashboard.env (gitignored) and fill in this machine.
# Hosts allowed to send writes besides loopback, comma-separated. Use the name
# `tailscale serve` forwards, for example <machine>.<tailnet>.ts.net.
DOTS_ALLOW_HOST=
# Dashboards of the executors, reached through their tunnel (name=url, comma-separated).
# A run done on an executor then shows its log and steps here.
DOTS_EXECUTOR_DASHBOARDS=
