[Unit]
Description=awf-gh (native): fire awf workflows for open PRs

# Used INSTEAD of dots-awf-gh.service when bin/configure picked awf-gh=local.
# Switch the same timer over with a drop-in, no copy of the timer needed:
#
#   systemctl --user edit dots-awf-gh.timer
#     [Timer]
#     Unit=dots-awf-gh-local.service
#
# Back to the container: remove that drop-in (systemctl --user revert dots-awf-gh.timer).

[Service]
Type=oneshot
WorkingDirectory=%h/projects/perso/opencode-dots
# Workflow steps default to /state, which only exists in the image.
Environment=STATE_DIR=%h/projects/perso/opencode-dots/state
# gh must be on PATH. The user manager's default PATH has /usr/bin and
# ~/.local/bin; add a line here if gh lives elsewhere.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# awf-gh.yaml here is generated from repos.yaml with host paths (make configure).
# Only GH_TOKEN is taken from .env: the watcher needs nothing else, and the rest
# (DISCORD_WEBHOOK) must not reach its children.
ExecStart=/bin/sh -c 'GH_TOKEN=$$(sed -n "s/^GH_TOKEN=//p" %h/projects/perso/opencode-dots/.env) && export GH_TOKEN && exec %h/projects/perso/opencode-dots/bin/awf-gh --config %h/projects/perso/opencode-dots/awf-gh.yaml'
TimeoutStartSec=180
