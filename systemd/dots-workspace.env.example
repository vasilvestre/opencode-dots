# Copy to ~/.config/dots/workspace.env (private: it names your server).
# The workspace repository, a private bare repository on the server:
DOTS_WORKSPACE_REMOTE=user@server.example:workspaces/default.git
# writer on the server, reader everywhere else:
DOTS_WORKSPACE_ROLE=reader
# Who you are, for the inbox file names:
DOTS_ACTOR=you
