# Copy to ~/.config/dots/executor.env (private: it names your server).
# The server to open the tunnel to, as ssh takes it.
DOTS_SERVER=user@server.example
# The port opened on the server's loopback: the executor's awf_url in repos.yaml
# (settings.executors) must point at it.
DOTS_TUNNEL_PORT=2512
# This machine's awf serve.
DOTS_LOCAL_AWF_PORT=2511
