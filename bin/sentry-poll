#!/usr/bin/env bash
# Sentry issues as work items (ADR 0039, docs/sources-sentry.md). For each `org/project owner/repo`
# line of sentry.list, ask the Sentry REST API for the unresolved issues seen lately and record each
# as a work item of that repository (bin/repos db ingest -source sentry).
#
# Read only: it never comments on, resolves or assigns an issue, and the agent is not
# involved. The credentials live in the environment, never in a file of this repository.
#
#   bin/sentry-poll
#
# Environment:
#   SENTRY_AUTH_TOKEN  a token with project:read and event:read (required)
#   SENTRY_URL       the host (default https://sentry.io; a region such as https://de.sentry.io)
#   SENTRY_PERIOD    statsPeriod, such as 24h or 7d (default 7d)
#   SENTRY_QUERY     the issue search (default is:unresolved)
#   SENTRY_MAX       issues per project and poll (default 100)
#   SENTRY_LIST      lines "org/project owner/repo" (default sentry.list, generated by `make repos`).
#                    No list, or one that lists nothing: exit 0.
#   REPOS_BIN        the repos binary (default bin/repos). STATE_DIR as everywhere.
#   SENTRY_CURL        the curl command (default curl; tests put a fake in front).
#
# Exit codes: 0 when nothing is wrong or there is nothing to do, 1 when a project could not
# be fetched or recorded (the others are still done).
set -euo pipefail
cd "$(dirname "$0")/.."
root=$PWD
export STATE_DIR=${STATE_DIR:-$root/state}
list=${SENTRY_LIST:-sentry.list}
repos=${REPOS_BIN:-bin/repos}
curl_bin=${SENTRY_CURL:-curl}
base=${SENTRY_URL:-https://sentry.io}
period=${SENTRY_PERIOD:-7d}
query=${SENTRY_QUERY:-is:unresolved}
max=${SENTRY_MAX:-100}

if [ ! -f "$list" ]; then echo "sentry-poll: no $list, nothing to poll"; exit 0; fi
command -v jq >/dev/null 2>&1 || { echo "sentry-poll: jq is required" >&2; exit 1; }
[ -x "$repos" ] || { echo "sentry-poll: $repos is missing, run \`make repos\` to build it" >&2; exit 1; }
[ -n "${SENTRY_AUTH_TOKEN:-}" ] || { echo "sentry-poll: SENTRY_AUTH_TOKEN is not set" >&2; exit 1; }
case "$base" in https://*) ;; *) echo "sentry-poll: SENTRY_URL must start with https://" >&2; exit 1 ;; esac
[[ $period =~ ^[0-9]+[hd]$ ]] || { echo "sentry-poll: SENTRY_PERIOD must look like 7d or 24h" >&2; exit 1; }
[[ $max =~ ^[0-9]+$ ]] || { echo "sentry-poll: SENTRY_MAX must be a number" >&2; exit 1; }

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
mask() { sed -E 's#(://)[^/@[:space:]]*@#\1***@#g' | head -n 5; }

failed=0
while read -r slug repo rest || [ -n "${slug:-}" ]; do
  case "${slug:-}" in ''|'#'*) continue ;; esac
  if [[ ! ${slug} =~ ^[a-z0-9][a-z0-9_-]*/[a-z0-9][a-z0-9_-]*$ ]] || [[ ! ${repo:-} =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]]; then
    echo "sentry-poll: skip invalid line: $slug ${repo:-}" >&2
    continue
  fi
  org=${slug%%/*}; project=${slug#*/}
  rc=0
  # The token goes to curl as a config on stdin, so it never shows in `ps`.
  printf 'header = "Authorization: Bearer %s"\n' "$SENTRY_AUTH_TOKEN" | \
    "$curl_bin" -sS --fail-with-body --max-time 60 -K - -G "${base%/}/api/0/projects/$org/$project/issues/" \
      --data-urlencode "query=$query" --data-urlencode "statsPeriod=$period" --data-urlencode "limit=$max" \
      -H 'Accept: application/json' > "$tmp/issues.json" 2> "$tmp/curl.err" || rc=$?
  if [ "$rc" != 0 ] || ! jq -e 'type == "array"' "$tmp/issues.json" >/dev/null 2>&1; then
    echo "sentry-poll: $slug: fetch failed (curl $rc): $(mask < "$tmp/curl.err")" >&2
    failed=1
    continue
  fi
  ingest() {
    "$repos" db ingest -dir "$root" -source sentry -repo "$repo" -org "$org" -project "$project" -json \
      < "$tmp/issues.json" > "$tmp/ingest.out" 2> "$tmp/ingest.err"
  }
  rc=0
  ingest || rc=$?
  if [ "$rc" != 0 ] && grep -q 'not a project' "$tmp/ingest.err" && [ -f "$root/repos.yaml" ]; then
    "$repos" db import -dir "$root" > /dev/null 2>&1 || true
    rc=0
    ingest || rc=$?
  fi
  if [ "$rc" != 0 ]; then
    echo "sentry-poll: $slug: could not record: $(mask < "$tmp/ingest.err")" >&2
    failed=1
    continue
  fi
  [ ! -s "$tmp/ingest.err" ] || echo "sentry-poll: $slug: $(mask < "$tmp/ingest.err")" >&2
  new=$(jq -rs '[.[] | select(.status == "new")] | length' "$tmp/ingest.out")
  changed=$(jq -rs '[.[] | select(.status == "changed")] | length' "$tmp/ingest.out")
  seen=$(jq -rs '[.[] | select(.status == "seen")] | length' "$tmp/ingest.out")
  echo "sentry-poll: $slug -> $repo: $new new, $changed changed, $seen seen"
done < "$list"
exit "$failed"
