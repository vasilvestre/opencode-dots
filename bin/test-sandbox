#!/usr/bin/env bash
# Tests for bin/patch-guard (no docker needed) and bin/sandbox-run (flags always;
# a real container only when the engine (DOTS_SANDBOX_ENGINE, docker by default) and a small local image are present).
set -euo pipefail
cd "$(dirname "$0")/.."

fails=0
ok() { echo "ok   $1"; }
bad() { echo "FAIL $1"; fails=$((fails + 1)); }

diff_of() { # path, optional extra header
  printf 'diff --git a/%s b/%s\n--- a/%s\n+++ b/%s\n@@ -1,2 +1,2 @@\n a\n-b\n+c\n' "$1" "$1" "$1" "$1"
}
expect() { # name want-exit patch-text args...
  local name=$1 want=$2 patch=$3 got=0
  shift 3
  printf '%s' "$patch" | bin/patch-guard "$@" >/dev/null 2>&1 || got=$?
  if [ "$got" = "$want" ]; then ok "$name"; else bad "$name (exit $got, want $want)"; fi
}

expect "plain source file passes" 0 "$(diff_of src/main.go)"
expect "empty input refused" 1 ""
expect "secret file refused" 1 "$(diff_of .env)"
expect "nested key file refused" 1 "$(diff_of config/server.pem)"
expect ".git refused" 1 "$(diff_of .git/config)"
expect "CI config refused" 1 "$(diff_of .github/workflows/ci.yml)"
expect "lock file refused" 1 "$(diff_of web/package-lock.json)"
expect "lock file allowed with flag" 0 "$(diff_of go.sum)" --allow-locks
expect "path traversal refused" 1 "$(diff_of ../etc/passwd)"
expect "outside allow-path refused" 1 "$(diff_of docs/a.md)" --allow-path 'src/*'
expect "inside allow-path passes" 0 "$(diff_of src/a.go)" --allow-path 'src/*'
expect "deny-path beats allow-path" 1 "$(diff_of src/gen/a.go)" --allow-path 'src/*' --deny-path 'src/gen/*'
expect "basename glob matches at depth" 1 "$(diff_of a/b/x.min.js)" --deny-path '*.min.js'
expect "second file in a diff is checked" 1 "$(diff_of ok.go; diff_of .env)"
expect "max-lines exceeded refused" 1 "$(diff_of a.go)" --max-lines 1
expect "max-lines at limit passes" 0 "$(diff_of a.go)" --max-lines 2
expect "symlink refused" 1 $'diff --git a/l b/l\nnew file mode 120000\n--- /dev/null\n+++ b/l\n@@ -0,0 +1 @@\n+/etc/passwd\n'
expect "binary refused" 1 $'diff --git a/i.png b/i.png\nBinary files a/i.png and b/i.png differ\n'
expect "rename into deny refused" 1 $'diff --git a/a.go b/.env\nsimilarity index 100%\nrename from a.go\nrename to .env\n'
# a removed line that looks like a header must count as content, not a path
expect "content line like a header is not a path" 0 $'diff --git a/a.go b/a.go\n--- a/a.go\n+++ b/a.go\n@@ -1,2 +1,2 @@\n--- a/.env\n+++ b/.env\n x\n'
expect "bad usage exits 2" 2 "" --bogus

# sandbox-run: refusal and flags need no docker
got=0; bin/sandbox-run other-image /tmp -- true >/dev/null 2>&1 || got=$?
[ "$got" = 2 ] && ok "foreign image prefix refused" || bad "foreign image prefix refused ($got)"
got=0; DOTS_SANDBOX_IMAGE_PREFIX=x- bin/sandbox-run dots-a /tmp -- true >/dev/null 2>&1 || got=$?
[ "$got" = 2 ] && ok "prefix is configurable" || bad "prefix is configurable ($got)"
got=0; bin/sandbox-run dots-a /nonexistent-dir -- true >/dev/null 2>&1 || got=$?
[ "$got" = 2 ] && ok "missing workdir refused" || bad "missing workdir refused ($got)"
cmd=$(bin/sandbox-run --print dots-a /tmp -- echo hi)
for flag in "--network none" "--read-only" "--cap-drop ALL" "no-new-privileges" "--pids-limit" "--memory" "--tmpfs" "--rm"; do
  case "$cmd" in *"$flag"*) ok "flag $flag present" ;; *) bad "flag $flag missing" ;; esac
done

# real container, when possible, with the engine bin/sandbox-run itself will use
eng=${DOTS_SANDBOX_ENGINE:-docker}
if command -v "$eng" >/dev/null && "$eng" info >/dev/null 2>&1; then
  img=${DOTS_TEST_IMAGE:-}
  if [ -z "$img" ]; then
    img=$("$eng" images --format '{{.Repository}}:{{.Tag}}' | grep '^dots-' | head -1 || true)
  fi
  if [ -z "$img" ]; then
    echo "skip real-container tests: no local image starting with dots- (set DOTS_TEST_IMAGE)"
  else
    work=$(mktemp -d); trap 'rm -rf "$work"' EXIT
    run() { bin/sandbox-run "$img" "$work" -- "$@"; }
    # each check is a positive proof: the probe prints a marker the guarantee makes true
    out=$(run sh -c 'ls /sys/class/net' 2>&1 || true)
    [ "$out" = lo ] && ok "network: only loopback exists" || bad "network: interfaces are '$out'"
    out=$(run sh -c 'wget -q -T 3 -O- http://1.1.1.1 >/dev/null 2>&1 && echo reached || echo blocked' 2>&1 || true)
    [ "$out" = blocked ] && ok "network: outbound connection fails" || bad "network: outbound connection ($out)"
    out=$(run sh -c 'nc -w 2 -z 1.1.1.1 80 >/dev/null 2>&1 && echo reached || echo blocked' 2>&1 || true)
    [ "$out" = blocked ] && ok "network: raw tcp connect fails" || bad "network: raw tcp connect ($out)"
    out=$(run sh -c 'touch /x 2>&1 || echo denied' 2>&1 || true)
    case "$out" in *denied*) ok "root read-only: write to / fails" ;; *) bad "root read-only ($out)" ;; esac
    out=$(run sh -c 'echo 1 > /etc/x 2>&1 || echo denied; mkdir /usr/x 2>&1 || echo denied' 2>&1 || true)
    [ "$(printf '%s\n' "$out" | grep -c denied)" = 2 ] && ok "root read-only: /etc and /usr not writable" || bad "root read-only /etc /usr ($out)"
    out=$(run sh -c 'grep CapEff /proc/self/status' 2>&1 || true)
    case "$out" in *0000000000000000) ok "capabilities: effective set empty" ;; *) bad "capabilities ($out)" ;; esac
    out=$(run sh -c 'grep CapBnd /proc/self/status' 2>&1 || true)
    case "$out" in *0000000000000000) ok "capabilities: bounding set empty" ;; *) bad "capabilities bounding ($out)" ;; esac
    out=$(run sh -c 'chown 0:0 /tmp 2>&1 || echo denied' 2>&1 || true)
    case "$out" in *denied*|*"not permitted"*) ok "capabilities: chown refused" ;; *) bad "capabilities chown ($out)" ;; esac
    out=$(run sh -c 'grep NoNewPrivs /proc/self/status' 2>&1 || true)
    case "$out" in *1) ok "no-new-privileges set" ;; *) bad "no-new-privileges ($out)" ;; esac
    out=$(run id -u 2>&1 || true)
    [ "$out" = "$(id -u)" ] && ok "runs as the caller's uid" || bad "uid is '$out'"
    # pids: the same 40 background sleepers fail to fork at a limit of 8 and succeed at 256
    spawn='for i in $(seq 40); do sleep 2 & done; echo forked; wait'
    out=$(DOTS_SANDBOX_PIDS=8 run sh -c "$spawn" 2>&1 || true)
    ctl=$(DOTS_SANDBOX_PIDS=256 run sh -c "$spawn" 2>&1 || true)
    if printf '%s' "$out" | grep -q "can't fork" && [ "$ctl" = forked ]; then ok "pids limit bites (control passes)"; else bad "pids limit ($out | $ctl)"; fi
    # memory: 32m limit, allocate ~200m in the shell's memory: the kernel kills it (137)
    got=0; DOTS_SANDBOX_MEMORY=32m run sh -c 'x=$(head -c 200000000 /dev/zero | tr "\0" a); echo survived' >"$work.out" 2>&1 || got=$?
    if [ "$got" != 0 ] && ! grep -q survived "$work.out"; then ok "memory limit bites (exit $got)"; else bad "memory limit ($got)"; fi
    rm -f "$work.out"
    # tmpfs size cap
    out=$(DOTS_SANDBOX_TMPFS_SIZE=4m run sh -c 'dd if=/dev/zero of=/tmp/f bs=1M count=20 2>&1 | grep -c "No space" ' 2>&1 || true)
    [ "$out" = 1 ] && ok "tmpfs size cap bites" || bad "tmpfs size cap ($out)"
    out=$(run sh -c 'echo hi > /tmp/f && cat /tmp/f' 2>&1 || true)
    [ "$out" = hi ] && ok "/tmp is writable" || bad "/tmp writable ($out)"
    out=$(run sh -c 'echo "#!/bin/sh" > /tmp/e; chmod +x /tmp/e; /tmp/e 2>&1 || echo denied' 2>&1 || true)
    case "$out" in *denied*|*"Permission denied"*) ok "/tmp is noexec" ;; *) bad "/tmp noexec ($out)" ;; esac
    # WORKDIR: read-only by default, read-write on request, the only writable place besides /tmp
    if run sh -c 'touch /work/x 2>/dev/null'; then bad "workdir writable by default"; else ok "workdir read-only by default"; fi
    [ ! -e "$work/x" ] && ok "nothing reached the host workdir" || bad "host workdir was written"
    chmod 777 "$work"
    DOTS_SANDBOX_WRITABLE=1 run sh -c 'touch /work/x' && [ -f "$work/x" ] && ok "workdir writable on request" || bad "workdir writable on request"
    out=$(DOTS_SANDBOX_WRITABLE=1 run sh -c 'for d in / /etc /usr /bin /root /var /home; do touch $d/probe 2>/dev/null && echo writable:$d; done; true' 2>&1 || true)
    [ -z "$out" ] && ok "writable workdir leaves the rest of the root read-only" || bad "unexpected writable places: $out"
    # timeout: the sleeper dies, status is 124, and no container is left behind
    got=0; DOTS_SANDBOX_TIMEOUT=2 run sleep 30 >/dev/null 2>&1 || got=$?
    [ "$got" = 124 ] && ok "timeout kills the run (124)" || bad "timeout kills the run ($got)"
    sleep 1
    left=$("$eng" ps -aq --filter name=dots-sandbox- | wc -l)
    [ "$left" = 0 ] && ok "timeout leaves no container behind" || bad "$left container(s) left after timeout"
    # the command's own exit status passes through
    got=0; run sh -c 'exit 7' >/dev/null 2>&1 || got=$?
    [ "$got" = 7 ] && ok "exit status passes through" || bad "exit status ($got)"
    # an image outside the prefix is refused before docker runs, even when it exists locally
    got=0; bin/sandbox-run alpine:latest "$work" -- true >/dev/null 2>&1 || got=$?
    [ "$got" = 2 ] && ok "existing image outside the prefix refused" || bad "image outside prefix ($got)"
  fi
else
  echo "skip real-container tests: $eng not available"
fi

[ "$fails" = 0 ] && echo "all passed" || { echo "$fails failed"; exit 1; }
