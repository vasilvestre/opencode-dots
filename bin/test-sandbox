#!/usr/bin/env bash
# Tests for bin/patch-guard (no docker needed) and bin/sandbox-run (flags always;
# a real container only when docker and a small local image are present).
set -euo pipefail
cd "$(dirname "$0")/.."

fails=0
ok() { echo "ok   $1"; }
bad() { echo "FAIL $1"; fails=$((fails + 1)); }

diff_of() { # path, optional extra header
  printf 'diff --git a/%s b/%s\n--- a/%s\n+++ b/%s\n@@ -1,2 +1,2 @@\n a\n-b\n+c\n' "$1" "$1" "$1" "$1"
}
expect() { # name want-exit patch-text args...
  local name=$1 want=$2 patch=$3 got=0
  shift 3
  printf '%s' "$patch" | bin/patch-guard "$@" >/dev/null 2>&1 || got=$?
  if [ "$got" = "$want" ]; then ok "$name"; else bad "$name (exit $got, want $want)"; fi
}

expect "plain source file passes" 0 "$(diff_of src/main.go)"
expect "empty input refused" 1 ""
expect "secret file refused" 1 "$(diff_of .env)"
expect "nested key file refused" 1 "$(diff_of config/server.pem)"
expect ".git refused" 1 "$(diff_of .git/config)"
expect "CI config refused" 1 "$(diff_of .github/workflows/ci.yml)"
expect "lock file refused" 1 "$(diff_of web/package-lock.json)"
expect "lock file allowed with flag" 0 "$(diff_of go.sum)" --allow-locks
expect "path traversal refused" 1 "$(diff_of ../etc/passwd)"
expect "outside allow-path refused" 1 "$(diff_of docs/a.md)" --allow-path 'src/*'
expect "inside allow-path passes" 0 "$(diff_of src/a.go)" --allow-path 'src/*'
expect "deny-path beats allow-path" 1 "$(diff_of src/gen/a.go)" --allow-path 'src/*' --deny-path 'src/gen/*'
expect "basename glob matches at depth" 1 "$(diff_of a/b/x.min.js)" --deny-path '*.min.js'
expect "second file in a diff is checked" 1 "$(diff_of ok.go; diff_of .env)"
expect "max-lines exceeded refused" 1 "$(diff_of a.go)" --max-lines 1
expect "max-lines at limit passes" 0 "$(diff_of a.go)" --max-lines 2
expect "symlink refused" 1 $'diff --git a/l b/l\nnew file mode 120000\n--- /dev/null\n+++ b/l\n@@ -0,0 +1 @@\n+/etc/passwd\n'
expect "binary refused" 1 $'diff --git a/i.png b/i.png\nBinary files a/i.png and b/i.png differ\n'
expect "rename into deny refused" 1 $'diff --git a/a.go b/.env\nsimilarity index 100%\nrename from a.go\nrename to .env\n'
# a removed line that looks like a header must count as content, not a path
expect "content line like a header is not a path" 0 $'diff --git a/a.go b/a.go\n--- a/a.go\n+++ b/a.go\n@@ -1,2 +1,2 @@\n--- a/.env\n+++ b/.env\n x\n'
expect "bad usage exits 2" 2 "" --bogus

# sandbox-run: refusal and flags need no docker
got=0; bin/sandbox-run other-image /tmp -- true >/dev/null 2>&1 || got=$?
[ "$got" = 2 ] && ok "foreign image prefix refused" || bad "foreign image prefix refused ($got)"
got=0; DOTS_SANDBOX_IMAGE_PREFIX=x- bin/sandbox-run dots-a /tmp -- true >/dev/null 2>&1 || got=$?
[ "$got" = 2 ] && ok "prefix is configurable" || bad "prefix is configurable ($got)"
got=0; bin/sandbox-run dots-a /nonexistent-dir -- true >/dev/null 2>&1 || got=$?
[ "$got" = 2 ] && ok "missing workdir refused" || bad "missing workdir refused ($got)"
cmd=$(bin/sandbox-run --print dots-a /tmp -- echo hi)
for flag in "--network none" "--read-only" "--cap-drop ALL" "no-new-privileges" "--pids-limit" "--memory" "--tmpfs" "--rm"; do
  case "$cmd" in *"$flag"*) ok "flag $flag present" ;; *) bad "flag $flag missing" ;; esac
done

# real container, when possible
if command -v docker >/dev/null && docker info >/dev/null 2>&1; then
  img=${DOTS_TEST_IMAGE:-}
  if [ -z "$img" ]; then
    img=$(docker images --format '{{.Repository}}:{{.Tag}}' | grep '^dots-' | head -1 || true)
  fi
  if [ -z "$img" ]; then
    echo "skip real-container tests: no local image starting with dots- (set DOTS_TEST_IMAGE)"
  else
    work=$(mktemp -d); trap 'rm -rf "$work"' EXIT
    if bin/sandbox-run "$img" "$work" -- sh -c 'wget -q -T 2 -O- http://1.1.1.1 >/dev/null 2>&1 || curl -s -m 2 http://1.1.1.1 >/dev/null 2>&1'; then
      bad "network is reachable"; else ok "network blocked"; fi
    if bin/sandbox-run "$img" "$work" -- sh -c 'touch /x 2>/dev/null'; then bad "root is writable"; else ok "root read-only"; fi
    if bin/sandbox-run "$img" "$work" -- sh -c 'touch /work/x 2>/dev/null'; then bad "workdir writable by default"; else ok "workdir read-only by default"; fi
    DOTS_SANDBOX_WRITABLE=1 bin/sandbox-run "$img" "$work" -- sh -c 'touch /work/x' && [ -f "$work/x" ] && ok "workdir writable on request" || bad "workdir writable on request"
    got=0; DOTS_SANDBOX_TIMEOUT=2 bin/sandbox-run "$img" "$work" -- sh -c 'sleep 30' >/dev/null 2>&1 || got=$?
    [ "$got" = 124 ] && ok "timeout kills the run" || bad "timeout kills the run ($got)"
  fi
else
  echo "skip real-container tests: docker not available"
fi

[ "$fails" = 0 ] && echo "all passed" || { echo "$fails failed"; exit 1; }
