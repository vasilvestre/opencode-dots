#!/usr/bin/env bash
# End-to-end tests of the real workflows through the real `awf`, offline.
# Fakes on PATH (test/e2e/fakes): gh (logs, canned answers), opencode (a stub
# agent that writes canned files), curl (fails). The "remote" is a local bare
# repository. See docs/e2e.md for the matrix, the fakes and the known defects.
#
#   bin/test-e2e                 everything
#   bin/test-e2e fix-issue       one section: fix-issue review classify held baseline upstream identity budget
#   E2E_KEEP=1 bin/test-e2e ...  keep the scratch trees (their paths are printed)
set -uo pipefail
cd "$(dirname "$0")/.."
command -v awf >/dev/null || { echo "bin/test-e2e: awf is not installed, nothing to run" >&2; exit 2; }
command -v jq >/dev/null || { echo "bin/test-e2e: jq is required" >&2; exit 2; }

E2E_TMP=$(mktemp -d)
export E2E_TMP
trap '[ -n "${E2E_KEEP:-}" ] || rm -rf "$E2E_TMP"' EXIT
# shellcheck source=../test/e2e/lib.sh
. test/e2e/lib.sh
# The same seed commits in every case, so shas are comparable between cases.
export GIT_AUTHOR_DATE="2026-01-01T00:00:00Z" GIT_COMMITTER_DATE="2026-01-01T00:00:00Z"

only=${1:-all}
want() { [ "$only" = all ] || [ "$only" = "$1" ]; }

# The commit before the gate existed (0a28bc8 wired publish-gate into the
# workflows). Its workflows are the "pre-gate behaviour" legacy must equal.
BASELINE_REV=0a28bc8~1

CEILINGS="observe propose act auto"

# The commit before ADR 0043 was implemented: its tend-repo is the legacy one.
UPSTREAM_BASE_REV=44ae246

# ---------------------------------------------------------------- fix-issue --
# fix_case MODE CEILING CLASS: one fix-issue run on a fresh case, left in $T.
# CEILING "legacy" passes no autonomy input at all.
fix_case() {
  local mode=$1 ceil=$2 cls=$3 args=(repo=$REPO issue=7)
  case_new "fix-issue $mode $ceil class $cls"
  [ "$ceil" = legacy ] || args+=("autonomy=$ceil")
  FAKE_FIX=$mode FAKE_CLASS=$cls run_wf fix-issue "${args[@]}"
}

# expected: what reaches GitHub for a ceiling and a class.
#   publishes  the ceiling lets it out (legacy, act, auto; propose and observe do not)
#   hold       propose, class 1 or 2: a held record
#   note       observe, or class 3 at any ceiling
effect() { # CEILING CLASS -> publish | hold | note
  local ceil=$1 cls=$2
  case "$ceil" in
    legacy) echo publish ;;
    observe) echo note ;;
    *) if [ "$cls" = 3 ]; then echo note; elif [ "$ceil" = propose ]; then echo hold; else echo publish; fi ;;
  esac
}

assert_fix_patch() { # CEILING CLASS
  local ceil=$1 cls=$2 eff label="fix-issue patch, $1, class $2"
  eff=$(effect "$ceil" "$cls")
  check "$label: run succeeds" test "$RC" = 0
  case "$eff" in
    publish)
      check "$label: branch pushed to origin" has_branch 'fix/7-*'
      check "$label: pull request created once" gh_once '^gh pr create'
      check "$label: closes the issue in the body" grep -q 'Closes #7' "$T/fake/posted/"*pr-create.md
      check "$label: no note, nothing held" test "$(n_files "$T/state/notes" '*')$(n_files "$T/state/held" '*')" = 00
      ;;
    hold)
      check "$label: nothing pushed" no_branch 'fix/*' 
      check "$label: no pull request" gh_none '^gh pr create'
      check "$label: push held once" test "$(held_of push)" = 1
      check "$label: held record names branch, base, title" bash -c "f=\$(ls $T/state/held/*-push-*); grep -q '^branch: fix/7-' \$f && grep -q '^base: main' \$f && grep -q '^title: Fix the crash' \$f"
      check "$label: held patch kept for the release" bash -c "f=\$(ls $T/state/held/*-push-*); a=\$(sed -n 's/^artifact: //p' \$f); [ -s \"\$a\" ]"
      check "$label: nothing in notes for the push" test "$(note_of push)" = 0
      ;;
    note)
      check "$label: nothing pushed" no_branch 'fix/*' 
      check "$label: no pull request" gh_none '^gh pr create'
      check "$label: push noted once" test "$(note_of push)" = 1
      check "$label: nothing held" test "$(n_files "$T/state/held" '*')" = 0
      ;;
  esac
  check "$label: no issue comment of the patch run's own accord" bash -c "[ '$eff' != publish ] || [ \$(grep -cE '^gh issue comment' $T/fake/gh.log) = 0 ]"
  check "$label: nothing left the machine but through the fakes" no_net
}

assert_fix_decline() { # CEILING CLASS
  local ceil=$1 cls=$2 eff label="fix-issue decline, $1, class $2"
  eff=$(effect "$ceil" "$cls")
  check "$label: run succeeds" test "$RC" = 0
  check "$label: no push, no pull request" no_push_no_pr
  case "$eff" in
    publish) check "$label: the answer is commented once" gh_once '^gh issue comment 7 --repo tester/demo'
             check "$label: the comment is the agent's answer" grep -q 'already fixed' "$T/fake/posted/"*issue-comment.md ;;
    hold)    check "$label: no comment" gh_none '^gh issue comment'
             check "$label: comment held once" test "$(held_of comment)" = 1 ;;
    note)    check "$label: no comment" gh_none '^gh issue comment'
             check "$label: comment noted once" test "$(note_of comment)" = 1 ;;
  esac
}

section_fix_issue() {
  say "== fix-issue: ceiling x class x outcome =="
  local mode ceil cls
  for mode in patch decline; do
    fix_case "$mode" legacy 1
    check "fix-issue $mode, legacy: no classification model call" agent_idle classify
    check "fix-issue $mode, legacy: no item_class file" test ! -e "$T/state/fix/$REPO/issue-7/item_class"
    check "fix-issue $mode, legacy: the gate is never called" bash -c "! grep -q 'publish-gate' $T/out.log"
    "assert_fix_$mode" legacy 1
    case_done
    for ceil in $CEILINGS; do
      for cls in 1 2 3; do
        fix_case "$mode" "$ceil" "$cls"
        check "fix-issue $mode, $ceil, class $cls: item_class is $cls" test "$(cat "$T/state/fix/$REPO/issue-7/item_class" 2>/dev/null)" = "$cls"
        "assert_fix_$mode" "$ceil" "$cls"
        case_done
      done
    done
  done

  say "-- fix-issue: a half-done fix (edits, no pull request text) fails and still obeys the gate --"
  for ceil in legacy observe propose act; do
    fix_case half "$ceil" 1
    check "fix-issue half, $ceil: the run fails (ABANDONED)" test "$RC" != 0
    check "fix-issue half, $ceil: nothing pushed, no pull request" no_push_no_pr
    case "$(effect "$ceil" 1)" in
      publish) check "fix-issue half, $ceil: the answer is commented" gh_once '^gh issue comment' ;;
      hold)    check "fix-issue half, $ceil: the answer comment is held" test "$(held_of comment)" = 1 ;;
      note)    check "fix-issue half, $ceil: the answer comment is a note" bash -c "[ $(note_of comment) = 1 ] && ! grep -q '^gh issue comment' $T/fake/gh.log" ;;
    esac
    case_done
  done

  say "-- fix-issue: a claim on the branch (bin/held exit 3) vetoes the push at every ceiling --"
  for ceil in legacy act; do
    case_new "fix-issue held claim $ceil"
    local a=(repo=$REPO issue=7)
    [ "$ceil" = legacy ] || a+=("autonomy=$ceil")
    FAKE_HELD_RC=3 FAKE_FIX=patch FAKE_CLASS=1 run_wf fix-issue "${a[@]}"
    check "fix-issue claim, $ceil: no push, no pull request" no_push_no_pr
    case_done
  done
}

# --------------------------------------------------------- classification ----
section_classify() {
  say "== classification fails closed =="
  local bad
  for bad in bad none; do
    case_new "classify $bad"
    FAKE_CLASS=$bad FAKE_FIX=patch run_wf fix-issue repo=$REPO issue=7 autonomy=auto
    check "classification '$bad': the agent still ran (the run analyses)" agent_ran fix
    check "classification '$bad': item_class is 3" test "$(cat "$T/state/fix/$REPO/issue-7/item_class" 2>/dev/null)" = 3
    check "classification '$bad': nothing pushed at auto" no_branch 'fix/*' 
    check "classification '$bad': no pull request" gh_none '^gh pr create'
    check "classification '$bad': the push is a note" test "$(note_of push)" = 1
    check "classification '$bad': run still succeeds" test "$RC" = 0
    case_done
  done

  say "== fix-issue: the sandbox check before a push =="
  local sb
  for sb in pass refuse; do
    case_new "fix-issue sandbox $sb"
    set_issue 7 "Crash on empty input" "The input field crashes the form."
    if [ "$sb" = pass ]; then b64=$(printf '%s' '{"max_lines":400}' | base64 -w0); else b64=$(printf '%s' '{"allow_paths":["docs/*"]}' | base64 -w0); fi
    FAKE_CLASS=1 FAKE_FIX=patch run_wf fix-issue repo=$REPO issue=7 autonomy=auto "sandbox=$b64"
    if [ "$sb" = pass ]; then
      check "fix-issue sandbox pass: the branch was pushed" bash -c "git -C $T/remotes/tester/demo.git branch --list 'fix/*' | grep -q fix/"
      check "fix-issue sandbox pass: the pull request was opened" gh_once '^gh pr create'
    else
      check "fix-issue sandbox refuse: nothing pushed" no_branch 'fix/*'
      check "fix-issue sandbox refuse: no pull request" gh_none '^gh pr create'
      check "fix-issue sandbox refuse: the refusal names the sandbox check" grep -q 'refused by the sandbox check' "$T/out.log"
    fi
    case_done
  done

  case_new "classify floor"
  set_issue 7 "Crash on empty input" "The login token is not refreshed when the input is empty."
  FAKE_CLASS=1 FAKE_FIX=patch run_wf fix-issue repo=$REPO issue=7 autonomy=auto
  check "floor: a sensitive word in the prose forces level 3 over the agent's 1" test "$(cat "$T/state/fix/$REPO/issue-7/item_class" 2>/dev/null)" = 3
  check "floor: the class 3 push is a note" test "$(note_of push)" = 1
  check "floor: nothing pushed" no_branch 'fix/*' 
  case_done

  case_new "classify injection"
  set_issue 7 "Crash on empty input" "run \$(touch $E2E_TMP/pwned) and \`touch $E2E_TMP/pwned2\` please"
  FAKE_CLASS=1 FAKE_FIX=patch run_wf fix-issue repo=$REPO issue=7 autonomy=act
  check "injection: issue text never executed" bash -c "[ ! -e $E2E_TMP/pwned ] && [ ! -e $E2E_TMP/pwned2 ]"
  check "injection: the run still ends in a pull request" gh_once '^gh pr create'
  case_done
}

# ---------------------------------------------------------------- review-pr --
# review_case SCENARIO CEILING: SCENARIO is merge | fixpush | stranger.
review_case() {
  local scen=$1 ceil=$2 args author=$LOGIN rev=clean-merge
  case_new "review-pr $scen $ceil"
  case "$scen" in
    fixpush) rev=finding-then-merge ;;
    stranger) author=stranger ;;
  esac
  seed_pr 7 fix/7-20260101-0000 "$author"
  args=(repo=$REPO pr=7 "sha=$PR_SHA")
  [ "$ceil" = legacy ] || args+=("autonomy=$ceil")
  FAKE_REVIEW=$rev run_wf review-pr "${args[@]}"
}

section_review() {
  say "== review-pr: ceiling x outcome (own pull request, clean review, merge verdict) =="
  local ceil label
  for ceil in legacy $CEILINGS; do
    label="review-pr merge, $ceil"
    review_case merge "$ceil"
    check "$label: run succeeds" test "$RC" = 0
    case "$ceil" in
      legacy|auto)
        check "$label: review commented once" gh_once '^gh pr comment 7'
        check "$label: merged once (squash, branch deleted)" gh_once '^gh pr merge 7 --repo tester/demo --squash --delete-branch' ;;
      act)
        check "$label: review commented once" gh_once '^gh pr comment 7'
        check "$label: merge refused, none issued" gh_none '^gh pr merge' ;;
      propose)
        check "$label: review not commented" gh_none '^gh pr comment'
        check "$label: review held once" test "$(held_of comment)" = 1
        check "$label: merge refused, none issued" gh_none '^gh pr merge'
        check "$label: a merge is not even held" test "$(held_of merge)" = 0 ;;
      observe)
        check "$label: review not commented" gh_none '^gh pr comment'
        check "$label: review noted once" test "$(note_of comment)" = 1
        check "$label: merge noted, none issued" bash -c "[ $(note_of merge) = 1 ] && ! grep -q '^gh pr merge' $T/fake/gh.log" ;;
    esac
    check "$label: no network" no_net
    case_done
  done

  say "== review-pr: a fix round pushes, ceiling by ceiling =="
  for ceil in legacy $CEILINGS; do
    label="review-pr fixpush, $ceil"
    review_case fixpush "$ceil"
    check "$label: run succeeds" test "$RC" = 0
    check "$label: the address agent ran" agent_ran address
    # the models come from model-presets.yaml (ADR 0052): the reviewer from the default preset,
    # the fixer from its override
    check "$label: the models are the presets'" test "$(cat "$T/fake/agent.models" | sort -u | tr '\n' ' ')" = "$(for r in review_model address_model; do MODEL_PRESETS=$REPO_ROOT/model-presets.yaml bin/model review-pr/$r default; done | sort -u | tr '\n' ' ')"
    check "$label: both review rounds ran" test "$(grep -c '^agent review' "$T/fake/agent.steps")" = 2
    check "$label: no merge in a run that pushed" gh_none '^gh pr merge'
    case "$ceil" in
      legacy|act|auto)
        check "$label: the fix reached the pull request branch" bash -c "git -C $T/remotes/tester/demo.git show fix/7-20260101-0000:src.txt | grep -q cleared"
        check "$label: one attempt counted" test "$(cat "$T/state/reviews/pr7/attempts" 2>/dev/null)" = 1 ;;
      propose)
        check "$label: origin branch untouched" bash -c "! git -C $T/remotes/tester/demo.git show fix/7-20260101-0000:src.txt | grep -q cleared"
        check "$label: the fix is held once, with branch and title" bash -c "[ $(held_of push) = 1 ] && grep -q '^branch: fix/7-20260101-0000' $T/state/held/*-push-* && grep -q '^title: Clear the empty input finding' $T/state/held/*-push-*"
        check "$label: the review comment is held too" test "$(held_of comment)" = 1 ;;
      observe)
        check "$label: origin branch untouched" bash -c "! git -C $T/remotes/tester/demo.git show fix/7-20260101-0000:src.txt | grep -q cleared"
        check "$label: push and comment are notes" bash -c "[ $(note_of push) = 1 ] && [ $(note_of comment) = 1 ]" ;;
    esac
    case_done
  done

  say "== review-pr: the sandbox check before a push (docs/runner.md) =="
  local b64
  for scen in pass refuse-path; do
    case_new "review-pr sandbox $scen"
    seed_pr 7 fix/7-20260101-0000 "$LOGIN"
    case $scen in
      pass) b64=$(printf '%s' '{"max_lines":400,"allow_paths":["src.txt"]}' | base64 -w0) ;;
      refuse-path) b64=$(printf '%s' '{"allow_paths":["docs/*"]}' | base64 -w0) ;;
    esac
    # No autonomy ceiling at all: the sandbox check alone must hold or let the push through.
    FAKE_REVIEW=finding-then-merge run_wf review-pr repo=$REPO pr=7 "sha=$PR_SHA" "sandbox=$b64"
    check "sandbox $scen: run succeeds" test "$RC" = 0
    if [ "$scen" = pass ]; then
      check "sandbox pass: the fix reached the pull request branch" bash -c "git -C $T/remotes/tester/demo.git show fix/7-20260101-0000:src.txt | grep -q cleared"
    else
      check "sandbox $scen: the branch is untouched" bash -c "! git -C $T/remotes/tester/demo.git show fix/7-20260101-0000:src.txt | grep -q cleared"
      check "sandbox $scen: the refusal says it was the sandbox check" grep -q 'refused by the sandbox check' "$T/out.log"
      check "sandbox $scen: a note records why" test "$(note_of push)" = 1
    fi
    check "sandbox $scen: no network" no_net
    case_done
  done

  say "== review-pr: whose pull request may the dot merge at auto =="
  review_case stranger legacy
  check "stranger, legacy: merged, as before the gate" gh_once '^gh pr merge 7'
  case_done
  for ceil in act auto; do
    review_case stranger "$ceil"
    check "stranger, $ceil: not merged" gh_none '^gh pr merge'
    case_done
  done
  review_case stranger auto
  check "stranger, auto: the refusal names the author" grep -q 'stranger wrote it' "$T/out.log"
  check "stranger, auto: a refusal leaves no record" test "$(n_files "$T/state/held" '*')$(n_files "$T/state/notes" '*merge*')" = 00
  check "stranger, auto: the review comment still went out" gh_once '^gh pr comment 7'
  case_done
  case_new "review-pr stranger auto scope all"
  seed_pr 7 fix/7-20260101-0000 stranger
  GATE_MERGE_SCOPE=all FAKE_REVIEW=clean-merge run_wf review-pr repo=$REPO pr=7 "sha=$PR_SHA" autonomy=auto
  check "stranger, auto, GATE_MERGE_SCOPE=all: merged" gh_once '^gh pr merge 7'
  case_done
  case_new "review-pr own auto, dot login differs"
  seed_pr 7 fix/7-20260101-0000 tester
  printf 'someone-else\n' > "$T/fake/gh/login"
  FAKE_REVIEW=clean-merge run_wf review-pr repo=$REPO pr=7 "sha=$PR_SHA" autonomy=auto
  check "own pull request when the dot logs in as another account: not merged" gh_none '^gh pr merge'
  case_done

  say "== review-pr: breaker, empty and invalid ceilings =="
  case_new "review-pr breaker"
  seed_pr 7 fix/7-20260101-0000 "$LOGIN"
  mkdir -p "$T/state/breaker"
  printf '{}\n' > "$T/state/breaker/tester__demo.json"
  FAKE_REVIEW=clean-merge run_wf review-pr repo=$REPO pr=7 "sha=$PR_SHA" autonomy=auto
  check "tripped breaker lowers auto to act: the review is commented" gh_once '^gh pr comment 7'
  check "tripped breaker lowers auto to act: no merge" gh_none '^gh pr merge'
  check "tripped breaker: the log says so" grep -q 'circuit breaker tripped' "$T/out.log"
  case_done
  case_new "review-pr explicit empty autonomy"
  seed_pr 7 fix/7-20260101-0000 "$LOGIN"
  FAKE_REVIEW=clean-merge run_wf review-pr repo=$REPO pr=7 "sha=$PR_SHA" autonomy=
  check "autonomy= (explicit empty) is legacy: merged" gh_once '^gh pr merge 7'
  check "autonomy= (explicit empty): the gate is never called" bash -c "! grep -q publish-gate $T/out.log"
  case_done
  case_new "review-pr invalid autonomy"
  seed_pr 7 fix/7-20260101-0000 "$LOGIN"
  FAKE_REVIEW=clean-merge run_wf review-pr repo=$REPO pr=7 "sha=$PR_SHA" autonomy=yolo
  check "autonomy=yolo is rejected before anything runs" test "$RC" != 0
  check "autonomy=yolo: nothing reached GitHub" bash -c "[ ! -s $T/fake/gh.log ]"
  case_done

  say "== review-pr: class 2 is never merged by the dot (ADR 0040) =="
  # The chain a real run follows: fix-issue (auto) classifies the issue at 2 and
  # opens the pull request; later review-pr (auto) reviews and merges it.
  case_new "chain class 2"
  FAKE_FIX=patch FAKE_CLASS=2 run_wf fix-issue repo=$REPO issue=7 autonomy=auto
  check "chain: fix-issue at auto, class 2 opened the pull request" gh_once '^gh pr create'
  local br body sha
  br=$(git -C "$T/remotes/tester/demo.git" for-each-ref --format='%(refname:short)' 'refs/heads/fix/7-*' | head -1)
  sha=$(git -C "$T/remotes/tester/demo.git" rev-parse "$br")
  git -C "$T/remotes/tester/demo.git" update-ref refs/pull/99/head "$sha"
  body=$(cat "$T/fake/posted/"*pr-create.md)
  jq -n --arg b "$body" --arg br "$br" --arg sha "$sha" --arg r "$REPO" \
    '{number:99, title:"Fix the crash on empty input", body:$b, url:("https://github.com/" + $r + "/pull/99"),
      author:{login:"tester"}, baseRefName:"main", headRefName:$br, headRepository:{nameWithOwner:$r},
      state:"OPEN", headRefOid:$sha, mergeable:"MERGEABLE", createdAt:"2026-01-01T00:00:00Z", comments:[]}' \
    > "$T/fake/gh/pr-99.json"
  : > "$T/fake/gh.log"
  FAKE_REVIEW=clean-merge run_wf review-pr repo=$REPO pr=99 "sha=$sha" autonomy=auto
  check "chain: review-pr at auto ran to the end" test "$RC" = 0
  check "chain: a pull request born from a class 2 item is not merged by review-pr at auto" gh_none '^gh pr merge'
  check "chain: the refusal says class 2" grep -q 'class 2 is never merged' "$T/out.log"
  check "chain: the review comment still went out (class 2 is not a note)" gh_once '^gh pr comment 99'
  case_done

  # The class file decides, branch by branch.
  local cls
  for cls in 1 3; do
    case_new "review-pr class $cls at auto"
    SEED_CLASS=$cls seed_pr 7 fix/7-20260101-0000 "$LOGIN"
    FAKE_REVIEW=clean-merge run_wf review-pr repo=$REPO pr=7 "sha=$PR_SHA" autonomy=auto
    check "class $cls pull request, auto: run succeeds" test "$RC" = 0
    if [ "$cls" = 1 ]; then
      check "class 1 pull request, auto: merged" gh_once '^gh pr merge 7'
      check "class 1 pull request, auto: commented" gh_once '^gh pr comment 7'
    else
      check "class 3 pull request, auto: not merged" gh_none '^gh pr merge'
      check "class 3 pull request, auto: the review is a note, not a comment" bash -c "! grep -q '^gh pr comment' $T/fake/gh.log && [ $(note_of comment) = 1 ]"
    fi
    case_done
  done
  for cls in none 9; do
    case_new "review-pr class $cls at auto"
    SEED_CLASS=$cls seed_pr 7 fix/7-20260101-0000 "$LOGIN"
    [ "$cls" = none ] || printf '%s\n' "$cls" > "$T/state/fix/$REPO/issue-7/item_class"
    FAKE_REVIEW=clean-merge run_wf review-pr repo=$REPO pr=7 "sha=$PR_SHA" autonomy=auto
    check "class file '$cls' on a fix/7-* branch, auto: fails closed, not merged" gh_none '^gh pr merge'
    check "class file '$cls' on a fix/7-* branch, auto: treated as class 3" grep -q 'class 3, a human diagnosis' "$T/out.log"
    case_done
  done
  case_new "review-pr class missing at act"
  SEED_CLASS=none seed_pr 7 fix/7-20260101-0000 "$LOGIN"
  FAKE_REVIEW=clean-merge run_wf review-pr repo=$REPO pr=7 "sha=$PR_SHA" autonomy=act
  check "missing class file, act: fails closed, the review is a note" bash -c "[ $(note_of comment) = 1 ] && ! grep -q '^gh pr comment' $T/fake/gh.log"
  case_done
  case_new "review-pr class missing, legacy"
  SEED_CLASS=none seed_pr 7 fix/7-20260101-0000 "$LOGIN"
  FAKE_REVIEW=clean-merge run_wf review-pr repo=$REPO pr=7 "sha=$PR_SHA"
  check "missing class file, legacy: merged as before" gh_once '^gh pr merge 7'
  check "missing class file, legacy: the gate is never called" bash -c "! grep -q publish-gate $T/out.log"
  case_done
  case_new "review-pr other branch at auto"
  seed_pr 7 fix/crash-on-empty "$LOGIN"
  FAKE_REVIEW=clean-merge run_wf review-pr repo=$REPO pr=7 "sha=$PR_SHA" autonomy=auto
  check "a fix/ branch with no issue number carries no class: the ceiling decides, merged" gh_once '^gh pr merge 7'
  case_done
  case_new "review-pr other branch, not a number"
  seed_pr 7 fix/7x-crash "$LOGIN"
  FAKE_REVIEW=clean-merge run_wf review-pr repo=$REPO pr=7 "sha=$PR_SHA" autonomy=auto
  check "fix/7x-* is not fix/<N>-*: no class, merged at auto" gh_once '^gh pr merge 7'
  case_done
}

# ------------------------------------------------------ publish-held release --
section_held() {
  say "== propose, then release with publish-held =="
  # fix-issue at propose: the patch is held, the person releases it.
  case_new "release fix-issue push"
  FAKE_FIX=patch FAKE_CLASS=1 run_wf fix-issue repo=$REPO issue=7 autonomy=propose
  local id
  id=$(held_id push)
  check "fix-issue propose: a push record is held" test -n "$id"
  : > "$T/fake/gh.log"
  RELEASED_BY=alice run_wf publish-held "id=$id"
  check "release push: run succeeds" test "$RC" = 0
  check "release push: the branch now exists on origin" has_branch 'fix/7-*'
  check "release push: with the held change" bash -c "git -C $T/remotes/tester/demo.git show \$(git -C $T/remotes/tester/demo.git for-each-ref --format='%(refname)' 'refs/heads/fix/7-*' | head -1):src.txt | grep -q fixed"
  check "release push: the commit keeps the held title" bash -c "git -C $T/remotes/tester/demo.git log -1 --format=%s \$(git -C $T/remotes/tester/demo.git for-each-ref --format='%(refname)' 'refs/heads/fix/7-*' | head -1) | grep -q 'Fix the crash on empty input'"
  check "release push: record moved to held/released/" bash -c "[ -f $T/state/held/released/$id ] && [ ! -f $T/state/held/$id ]"
  check "release push: released.log says who" grep -q "alice.*push.*$REPO#7" "$T/state/held/released.log"
  check "release push: re-releasing the same record is refused" bash -c "cd $T/proj && ! PATH=$E2E_DIR/fakes:\$PATH HOME=$T/home FAKE_DIR=$T/fake STATE_DIR=$T/state DOTS_HOME=$T/dots GIT_CONFIG_GLOBAL=$T/gitconfig awf run publish-held --storage $T/awf --input id=$id >/dev/null 2>&1"
  check "release push: no pull request opened by the push release alone" gh_none '^gh pr create'
  check "release push: the open-pr record is still held for the person" test -n "$(held_id open-pr)"
  local opid
  opid=$(held_id open-pr)
  check "release push: the open-pr record names fix.md, branch, base, title and closes" bash -c "f=$T/state/held/$opid; grep -q '^branch: fix/7-' \$f && grep -q '^base: main' \$f && grep -q '^title: Fix the crash on empty input' \$f && grep -q '^closes: 7' \$f && grep -q '^artifact: .*/held/artifacts/.*/fix.md' \$f"
  RELEASED_BY=alice run_wf publish-held "id=$opid"
  check "release open-pr after push: run succeeds" test "$RC" = 0
  check "release open-pr after push: the pull request is created once, from the pushed branch" bash -c "[ \$(grep -cE '^gh pr create --repo tester/demo --head fix/7-[0-9-]+ --base main' $T/fake/gh.log) = 1 ]"
  check "release open-pr after push: the body closes the issue" bash -c "grep -q 'Closes #7' $T/fake/posted/*pr-create.md"
  check "release open-pr after push: record moved to held/released/" test -f "$T/state/held/released/$opid"
  case_done

  # The pull request first: refused until the branch is on the remote.
  case_new "release open-pr before push"
  FAKE_FIX=patch FAKE_CLASS=1 run_wf fix-issue repo=$REPO issue=7 autonomy=propose
  check "propose: one push record and one open-pr record" bash -c "[ $(held_of push) = 1 ] && [ $(held_of open-pr) = 1 ]"
  opid=$(held_id open-pr)
  id=$(held_id push)
  : > "$T/fake/gh.log"
  run_wf publish-held "id=$opid"
  check "release open-pr first: refused" test "$RC" != 0
  check "release open-pr first: the message says to release the push first" grep -q 'is not on tester/demo yet; release the push record' "$T/out.log"
  check "release open-pr first: no pull request opened" gh_none '^gh pr create'
  check "release open-pr first: the record stays held" test -f "$T/state/held/$opid"
  run_wf publish-held "id=$id"
  run_wf publish-held "id=$opid"
  check "release in order: push, then open-pr, succeeds" test "$RC" = 0
  check "release in order: the pull request is opened" gh_once '^gh pr create'
  case_done

  # A claim on the branch holds the push and still leaves nothing to release.
  case_new "propose with a claim"
  FAKE_HELD_RC=3 FAKE_FIX=patch FAKE_CLASS=1 run_wf fix-issue repo=$REPO issue=7 autonomy=propose
  check "propose, claimed branch: no push and no open-pr record" bash -c "[ $(held_of push) = 0 ] && [ $(held_of open-pr) = 0 ]"
  case_done

  # At act the push is allowed: no held open-pr record, the pull request opens.
  case_new "act has no held records"
  FAKE_FIX=patch FAKE_CLASS=1 run_wf fix-issue repo=$REPO issue=7 autonomy=act
  check "act: the pull request is opened and nothing is held" bash -c "[ $(held_of open-pr) = 0 ] && grep -q '^gh pr create' $T/fake/gh.log"
  case_done

  # The held artifact lives inside the per-issue directory that the next
  # fix-issue run wipes.
  case_new "release after a rerun"
  FAKE_FIX=patch FAKE_CLASS=1 run_wf fix-issue repo=$REPO issue=7 autonomy=propose
  id=$(held_id push)
  FAKE_FIX=decline FAKE_CLASS=1 run_wf fix-issue repo=$REPO issue=7 autonomy=propose
  run_wf publish-held "id=$id"
  check "a held push survives the next fix-issue run on the same issue" test "$RC" = 0
  check "a held push survives: the held change reached the branch" bash -c "git -C $T/remotes/tester/demo.git show \$(git -C $T/remotes/tester/demo.git for-each-ref --format='%(refname)' 'refs/heads/fix/7-*' | head -1):src.txt | grep -q fixed"
  check "held record: artifact is a copy under held/artifacts, source is the original" bash -c "f=\$(ls $T/state/held/released/$id $T/state/held/$id 2>/dev/null | head -1); grep -q '^artifact: .*/held/artifacts/.*/held.patch' \$f && grep -q '^source: .*/fix/tester/demo/issue-7/held.patch' \$f"
  case_done

  # The rerun deletes the original answer too: the held comment keeps its copy.
  case_new "release a held answer after a rerun"
  FAKE_FIX=decline FAKE_CLASS=1 run_wf fix-issue repo=$REPO issue=7 autonomy=propose
  id=$(held_id comment)
  check "decline at propose: the answer is held" test -n "$id"
  rm -rf "$T/state/fix"
  run_wf publish-held "id=$id"
  check "held answer survives the wipe of its source directory" test "$RC" = 0
  check "held answer survives: the comment was posted" gh_once '^gh issue comment 7'
  case_done

  # review-pr at propose: the comment is held and released.
  case_new "release review comment"
  seed_pr 7 fix/7-20260101-0000 "$LOGIN"
  FAKE_REVIEW=clean-merge run_wf review-pr repo=$REPO pr=7 "sha=$PR_SHA" autonomy=propose
  id=$(held_id comment)
  check "review-pr propose: the review comment is held" test -n "$id"
  : > "$T/fake/gh.log"
  run_wf publish-held "id=$id"
  check "release comment: run succeeds" test "$RC" = 0
  check "release comment: posted once with the held review text" bash -c "[ \$(grep -cE '^gh issue comment 7 --repo tester/demo' $T/fake/gh.log) = 1 ] && grep -q 'Nothing to report' $T/fake/posted/*issue-comment.md"
  check "release comment: record moved to held/released/" test -f "$T/state/held/released/$id"
  case_done

  # review-pr fix round held, then released onto the branch.
  case_new "release review push"
  seed_pr 7 fix/7-20260101-0000 "$LOGIN"
  FAKE_REVIEW=finding-then-merge run_wf review-pr repo=$REPO pr=7 "sha=$PR_SHA" autonomy=propose
  id=$(held_id push)
  check "review-pr propose: the fix push is held" test -n "$id"
  run_wf publish-held "id=$id"
  check "release review push: run succeeds" test "$RC" = 0
  check "release review push: the branch carries the fix" bash -c "git -C $T/remotes/tester/demo.git show fix/7-20260101-0000:src.txt | grep -q cleared"
  check "release review push: record moved to held/released/" test -f "$T/state/held/released/$id"
  case_done

  # A claim set after the hold still vetoes the release.
  case_new "release claim"
  seed_pr 7 fix/7-20260101-0000 "$LOGIN"
  FAKE_REVIEW=finding-then-merge run_wf review-pr repo=$REPO pr=7 "sha=$PR_SHA" autonomy=propose
  id=$(held_id push)
  FAKE_HELD_RC=3 run_wf publish-held "id=$id"
  check "release under a human claim is refused" test "$RC" != 0
  check "release under a human claim: the record stays held" test -f "$T/state/held/$id"
  check "release under a human claim: the branch is untouched" bash -c "! git -C $T/remotes/tester/demo.git show fix/7-20260101-0000:src.txt | grep -q cleared"
  case_done
}

# -------------------------------------------------------- legacy == pre-gate --
# Run the workflows as they were just before the gate (git show BASELINE_REV)
# and the current ones with no autonomy input, same fakes, same seed. What
# reached the fake GitHub (every call, in order, with run noise folded), the
# files given to gh, and the origin refs' contents must be identical.
section_baseline() {
  say "== legacy equals the pre-gate behaviour ($BASELINE_REV) =="
  if ! git rev-parse --verify -q "$BASELINE_REV^{commit}" >/dev/null; then
    say "SKIP  baseline: $BASELINE_REV is not in this clone (shallow?)"
    return
  fi
  local base=$E2E_TMP/baseline-wf
  rm -rf "$base"
  mkdir -p "$base"
  git archive "$BASELINE_REV" workflows | tar -x -C "$base"
  check "baseline: the old workflows have no gate" bash -c "! grep -rq publish-gate $base/workflows"

  local scen cur old
  for scen in fix-patch fix-decline review-merge review-fixpush; do
    for which in old new; do
      if [ "$which" = old ]; then case_new "baseline $scen old" "$base/workflows"; else case_new "baseline $scen new"; fi
      case "$scen" in
        fix-patch)  FAKE_FIX=patch run_wf fix-issue repo=$REPO issue=7 ;;
        fix-decline) FAKE_FIX=decline run_wf fix-issue repo=$REPO issue=7 ;;
        review-merge)
          seed_pr 7 fix/7-20260101-0000 "$LOGIN"
          FAKE_REVIEW=clean-merge run_wf review-pr repo=$REPO pr=7 "sha=$PR_SHA" ;;
        review-fixpush)
          seed_pr 7 fix/7-20260101-0000 "$LOGIN"
          FAKE_REVIEW=finding-then-merge run_wf review-pr repo=$REPO pr=7 "sha=$PR_SHA" ;;
      esac
      {
        echo "rc=$RC"
        norm_log | sed -E 's/[0-9a-f]{40}/<sha>/g'
        echo "--- posted"
        for f in "$T/fake/posted/"*; do [ -f "$f" ] && { basename "$f" | sed 's/^[0-9]*-//'; cat "$f"; }; done
        echo "--- origin"
        for r in $(git -C "$T/remotes/tester/demo.git" for-each-ref --format='%(refname)' | grep -v '^refs/pull'); do
          echo "$r" | sed -E 's#fix/7-[0-9]{8}-[0-9]{4}#fix/7-<ts>#'
          git -C "$T/remotes/tester/demo.git" show "$r:src.txt" | sed 's/^/  /'
        done
        echo "--- state"
        (cd "$T/state" && find . -type f ! -name '*.lock' | grep -vE '\.fake-|/work/|\.json$|push\.log' | sed -E 's#(pr[0-9]+-)[0-9a-f]{40}#\1<sha>#' | sort)
        echo "--- agents"
        sort "$T/fake/agent.steps"
        echo "--- notes and held records: $(n_files "$T/state/notes" '*') $(n_files "$T/state/held" '*')"
      } > "$E2E_TMP/bl.$scen.$which"
      case_done
    done
    check "baseline $scen: legacy run equals the pre-gate run (calls, bodies, origin, state)" cmp -s "$E2E_TMP/bl.$scen.old" "$E2E_TMP/bl.$scen.new"
    check "baseline $scen: the compared record is not empty" test "$(wc -l < "$E2E_TMP/bl.$scen.new")" -gt 12
    cmp -s "$E2E_TMP/bl.$scen.old" "$E2E_TMP/bl.$scen.new" || diff "$E2E_TMP/bl.$scen.old" "$E2E_TMP/bl.$scen.new" | head -20
  done
}

# ---------------------------------------------------------------- upstream --
# file-upstream and the tend-repo hook (ADR 0043). UP is the one listed upstream.
UP=up/tool
UPSLUG=up__tool

# up_case LABEL [full|nolog] [upstream] [title]: a case with a finding on disk.
up_case() {
  local label=$1 ev=${2:-full} tgt=${3:-$UP} title=${4:-"Tool crashes on an empty config"}
  case_new "upstream $label"
  mkdir -p "$T/state/f"
  jq -n --arg t "$title" --arg u "$tgt" --arg ev "$ev" '{title:$t, upstream:$u,
    evidence:{command:"tool run --config empty.toml", versions:"tool 1.2.3, go 1.24",
      log:(if $ev == "nolog" then "" else "panic: nil map in loadConfig\n  at config.go:41" end),
      expected:"a clear error about the empty file"}}' > "$T/state/f/finding.json"
}
up_ledger() { echo "$T/state/upstream/$UPSLUG/ledger.tsv"; }
up_filed() { grep -c "	filed	" "$(up_ledger)" 2>/dev/null || true; }
# up_run CEILING [key=value ...]
up_run() {
  local aut=$1
  shift
  run_wf file-upstream repo=$REPO "upstream=$UP=${CAP:-2}" "autonomy=$aut" "finding_file=$T/state/f/finding.json" "$@"
}
up_created() { gh_once "^gh issue create --repo $UP "; }
# Nothing was written anywhere: no issue, no comment, no pull request.
up_no_write() { gh_none '^gh issue (create|comment|edit|close)' && gh_none '^gh pr '; }
# Only creates, only on the upstream.
up_only_create() { gh_none '^gh issue (comment|edit|close)' && gh_none '^gh pr ' && gh_none "^gh issue create --repo $REPO"; }
up_decision() { grep -q "$1" "$T/state/upstream/decisions.tsv"; }
up_posted() { cat "$T/fake/posted/"*issue-create.md; }
up_posted_has() { up_posted | grep -q -- "$1"; }
up_posted_lacks() { ! up_posted | grep -q -- "$1"; }

section_upstream() {
  say "== upstream: file-upstream and the tend-repo hook (ADR 0043) =="
  local rec

  up_case "auto with evidence"
  up_run auto
  check "upstream auto: run succeeds" test "$RC" = 0
  check "upstream auto: one issue created on the upstream" up_created
  check "upstream auto: no agent step without draft" agent_idle draft-upstream
  check "upstream auto: only a create on the upstream" up_only_create
  check "upstream auto: the body says an automated agent filed it, naming the dot" up_posted_has 'Filed by an automated agent (the dot `tester`)'
  check "upstream auto: the body ends with the machine marker" bash -c "up_posted() { cat $T/fake/posted/*issue-create.md; }; up_posted | tail -n1 | grep -Eq '^<!-- opencode-dots:file-upstream:[0-9a-f]{16} -->\$'"
  check "upstream auto: the body carries the evidence" up_posted_has 'panic: nil map in loadConfig'
  check "upstream auto: the body carries the versions" up_posted_has 'tool 1.2.3'
  check "upstream auto: the body names no own repository" up_posted_lacks "$REPO"
  check "upstream auto: a filed row is in the ledger" test "$(up_filed)" = 1
  case_done

  up_case "auto with a drafting agent"
  up_run auto draft=true
  check "upstream draft: the agent drafted" agent_ran draft-upstream
  check "upstream draft: the draft title is used" gh_some '^gh issue create --repo up/tool --title Drafted: tool crashes'
  check "upstream draft: a forged marker in the draft is dropped, one marker remains" test "$(up_posted | grep -c 'opencode-dots:file-upstream')" = 1
  check "upstream draft: a mention is defused" up_posted_has '@ someone'
  check "upstream draft: no live mention" up_posted_lacks '@someone'
  check "upstream draft: the footer is still there" up_posted_has 'Filed by an automated agent'
  case_done

  up_case "a draft that was not written falls back to the evidence"
  FAKE_DRAFT=none up_run auto draft=true
  check "upstream draft missing: the evidence body is filed" up_posted_has 'panic: nil map'
  check "upstream draft missing: with the original title" gh_some '^gh issue create --repo up/tool --title Tool crashes on an empty config'
  case_done

  up_case "refused at act"
  up_run act
  check "upstream act: run succeeds" test "$RC" = 0
  check "upstream act: no write at all" up_no_write
  check "upstream act: the refusal is recorded" up_decision 'gate said 5'
  check "upstream act: the gate reason is in the log" grep -q 'needs auto' "$T/out.log"
  check "upstream act: nothing held" test "$(held_of file-issue)" = 0
  case_done

  up_case "held at propose, then released"
  up_run propose
  check "upstream propose: nothing created" up_no_write
  check "upstream propose: one held record" test "$(held_of file-issue)" = 1
  rec=$(held_id file-issue)
  check "upstream propose: the record names the target" grep -qx "target: $UP" "$T/state/held/$rec"
  check "upstream propose: the record names the title" grep -qx 'title: Tool crashes on an empty config' "$T/state/held/$rec"
  up_run propose
  check "upstream propose: the same finding is not held twice" test "$(held_of file-issue)" = 1
  up_run act "release=$rec"
  check "upstream release: the issue is created once" up_created
  check "upstream release: the record moved to released/" test -e "$T/state/held/released/$rec" -a ! -e "$T/state/held/$rec"
  check "upstream release: the body is the held one, footer included" up_posted_has 'Filed by an automated agent'
  check "upstream release: a filed row follows the held row" test "$(up_filed)" = 1
  case_done

  up_case "release of a record that is not file-issue"
  mkdir -p "$T/state/held"
  printf 'action: comment\nref: x/y#1\nartifact: none\n' > "$T/state/held/x-comment.txt"
  up_run act release=x-comment.txt
  check "upstream release: a comment record is refused" up_no_write
  case_done

  # publish-held releases a file-issue record through file-upstream (the dashboard's Release).
  # up_hold: a case with one held record, its id in $rec.
  up_hold() {
    up_case "publish-held $1"
    up_run propose
    rec=$(held_id file-issue)
    : > "$T/fake/gh.log"
  }
  up_rel() { run_wf publish-held "id=$rec" "repo=$REPO" "upstream=$UP=${CAP:-2}"; }
  up_stays() { test -e "$T/state/held/$rec" -a ! -e "$T/state/held/released/$rec"; }

  up_hold "release succeeds"
  up_rel
  check "publish-held file-issue: the run succeeds" test "$RC" = 0
  check "publish-held file-issue: one issue created, on the upstream" up_created
  check "publish-held file-issue: only a create" up_only_create
  check "publish-held file-issue: the duplicate search ran first" gh_some '^gh issue list --repo up/tool --state all'
  check "publish-held file-issue: the held body is filed, footer included" up_posted_has 'Filed by an automated agent'
  check "publish-held file-issue: the record moved to released/" test -e "$T/state/held/released/$rec" -a ! -e "$T/state/held/$rec"
  check "publish-held file-issue: a log line names the record" grep -q "file-issue.*$rec" "$T/state/held/released.log"
  check "publish-held file-issue: a filed row in the ledger" test "$(up_filed)" = 1
  check "publish-held file-issue: no lock left" test ! -e "$T/state/held/.release-$rec"
  check "publish-held file-issue: no agent step" agent_idle draft-upstream
  up_rel
  check "publish-held file-issue: a second release is refused" test "$RC" != 0
  check "publish-held file-issue: ... and files nothing more" up_created
  check "publish-held file-issue: ... and says already released" grep -q 'already released' "$T/out.log"
  case_done

  up_hold "release refused on a duplicate"
  printf '[{"number":5,"title":"Tool crashes on empty config","body":"x","state":"OPEN","url":"https://github.com/up/tool/issues/5"}]\n' > "$T/fake/gh/up-issues-up_tool.json"
  up_rel
  check "publish-held duplicate: the run fails" test "$RC" != 0
  check "publish-held duplicate: nothing created" up_no_write
  check "publish-held duplicate: the record stays held" up_stays
  check "publish-held duplicate: the reason names the issue" grep -q 'duplicate on up/tool: #5' "$T/out.log"
  check "publish-held duplicate: no lock left" test ! -e "$T/state/held/.release-$rec"
  case_done

  up_hold "release refused at the weekly cap"
  now=$(date +%s)
  for k in 3 4; do printf '%s\t-\tfiled\th%s\thttps://github.com/up/tool/issues/%s\told\n' "$((now - k * 86400))" "$k" "$k" >> "$(up_ledger)"; done
  up_rel
  check "publish-held cap: the run fails" test "$RC" != 0
  check "publish-held cap: nothing created" up_no_write
  check "publish-held cap: the record stays held" up_stays
  check "publish-held cap: the reason is the cap" grep -q 'weekly cap reached for up/tool' "$T/out.log"
  case_done

  up_hold "release refused with the off switch"
  printf 'two closed as invalid\n' > "$T/state/upstream/$UPSLUG/off"
  up_rel
  check "publish-held off: the run fails" test "$RC" != 0
  check "publish-held off: nothing created" up_no_write
  check "publish-held off: the record stays held" up_stays
  check "publish-held off: the reason says switched off" grep -q 'switched off' "$T/out.log"
  case_done

  up_hold "release refused without a target"
  sed -i '/^target: /d' "$T/state/held/$rec"
  up_rel
  check "publish-held no target: the run fails" test "$RC" != 0
  check "publish-held no target: nothing created, no search" gh_none '^gh issue'
  check "publish-held no target: the record stays held" up_stays
  check "publish-held no target: the message says so" grep -q 'names no target' "$T/out.log"
  case_done

  up_hold "release refused when the target is no longer listed"
  run_wf publish-held "id=$rec" "repo=$REPO" "upstream=other/thing=2"
  check "publish-held unlisted: the run fails" test "$RC" != 0
  check "publish-held unlisted: nothing created, no search" gh_none '^gh issue'
  check "publish-held unlisted: the record stays held" up_stays
  case_done

  up_case "note at observe"
  up_run observe
  check "upstream observe: one note" test "$(note_of file-issue)" = 1
  check "upstream observe: nothing written" up_no_write
  case_done

  up_case "duplicate by title, open"
  printf '[{"number":5,"title":"Tool crashes on empty config","body":"x","state":"OPEN","url":"https://github.com/up/tool/issues/5"}]\n' > "$T/fake/gh/up-issues-up_tool.json"
  up_run auto
  check "upstream duplicate: nothing created" up_no_write
  check "upstream duplicate: the reason names the issue" up_decision 'duplicate on up/tool: #5 (open)'
  check "upstream duplicate: the ledger keeps a skipped row" grep -q '	skipped	' "$(up_ledger)"
  check "upstream duplicate: the search covered open and closed" gh_some '^gh issue list --repo up/tool --state all'
  up_run auto
  check "upstream duplicate: a second run stops on the ledger without a new search" test "$(gh_count '^gh issue list')" = 1
  case_done

  up_case "duplicate by error string, closed"
  printf '[{"number":9,"title":"Unrelated words here","body":"we see panic: nil map in loadConfig again","state":"CLOSED","url":"https://github.com/up/tool/issues/9"}]\n' > "$T/fake/gh/up-issues-up_tool.json"
  up_run auto
  check "upstream duplicate (closed, same error): nothing created" up_no_write
  check "upstream duplicate (closed, same error): recorded" up_decision '#9 (closed)'
  case_done

  up_case "duplicate with a reworded title, same log line"
  printf '[{"number":12,"title":"Segfault when configuration is blank","body":"log: panic: nil map in loadConfig","state":"OPEN","url":"https://github.com/up/tool/issues/12"}]\n' > "$T/fake/gh/up-issues-up_tool.json"
  up_run auto
  check "upstream reworded duplicate: run succeeds" test "$RC" = 0
  check "upstream reworded duplicate: nothing created" up_no_write
  check "upstream reworded duplicate: the decision names the issue" up_decision 'duplicate on up/tool: #12 (open)'
  check "upstream reworded duplicate: a skipped ledger row" grep -q '	skipped	' "$(up_ledger)"
  check "upstream reworded duplicate: a small tracker costs one list call" test "$(gh_count '^gh issue list')" = 1
  case_done

  up_case "large tracker, duplicate beyond the newest 100"
  jq -n '[range(1;131) | {number:(1000-.), title:("Filler topic \(.) alpha"), body:"nothing", state:"OPEN", url:"https://github.com/up/tool/issues/\(1000-.)"}]
    + [{number:7,title:"Segfault when configuration is blank",body:"log: panic: nil map in loadConfig",state:"CLOSED",url:"https://github.com/up/tool/issues/7"}]' > "$T/fake/gh/up-issues-up_tool.json"
  up_run auto
  check "upstream large tracker: nothing created" up_no_write
  check "upstream large tracker: the older issue is found" up_decision 'duplicate on up/tool: #7 (closed)'
  check "upstream large tracker: the search fallback ran" gh_some '^gh issue list .*--search'
  check "upstream large tracker: the plain list ran first" gh_some '^gh issue list --repo up/tool --state all --limit 100 --json'
  case_done

  up_case "unrelated issue only"
  printf '[{"number":3,"title":"Docs typo in install section","body":"readme says instal","state":"OPEN","url":"https://github.com/up/tool/issues/3"}]\n' > "$T/fake/gh/up-issues-up_tool.json"
  up_run auto
  check "upstream unrelated issue: one issue created" up_created
  check "upstream unrelated issue: a filed row" test "$(up_filed)" = 1
  check "upstream unrelated issue: one list call" test "$(gh_count '^gh issue list')" = 1
  case_done

  up_case "the list call fails"
  : > "$T/fake/gh/up-list-fail-up_tool"
  up_run auto
  check "upstream list failure: nothing created" up_no_write
  check "upstream list failure: the reason says a duplicate cannot be ruled out" up_decision 'cannot be ruled out'
  case_done

  up_case "duplicate search fails"
  printf 'not json\n' > "$T/fake/gh/up-issues-up_tool.json"
  up_run auto
  check "upstream unreadable search answer: nothing created" up_no_write
  case_done

  up_case "weekly cap reached"
  mkdir -p "$T/state/upstream/$UPSLUG"
  now=$(date +%s)
  for k in 3 4; do printf '%s\t-\tfiled\th%s\thttps://github.com/up/tool/issues/%s\told\n' "$((now - k * 86400))" "$k" "$k" >> "$(up_ledger)"; done
  up_run auto
  check "upstream weekly cap: nothing created" up_no_write
  check "upstream weekly cap: recorded" up_decision 'weekly cap reached for up/tool (2 of 2)'
  check "upstream weekly cap: no search was made" gh_none '^gh issue list'
  case_done

  up_case "daily cap reached"
  mkdir -p "$T/state/upstream/$UPSLUG"
  printf '%s\t-\tfiled\th1\thttps://github.com/up/tool/issues/1\trecent\n' "$(( $(date +%s) - 3600 ))" >> "$(up_ledger)"
  CAP=20 up_run auto
  check "upstream daily cap: nothing created though the week allows 20" up_no_write
  check "upstream daily cap: recorded" up_decision 'daily cap reached'
  case_done

  up_case "no evidence" nolog
  up_run auto
  check "upstream no evidence: run succeeds" test "$RC" = 0
  check "upstream no evidence: no gh call on a tracker" gh_none '^gh issue'
  check "upstream no evidence: an internal note is written" test "$(note_of file-issue)" = 1
  check "upstream no evidence: the reason is recorded" up_decision 'no evidence'
  case_done

  up_case "unlisted repository" full other/thing
  up_run auto
  check "upstream unlisted: nothing created" up_no_write
  check "upstream unlisted: no gh call about issues" gh_none '^gh issue'
  check "upstream unlisted: recorded" up_decision 'other/thing is not in the upstream list'
  case_done

  up_case "the repository itself" full "$REPO"
  up_run auto
  check "upstream self: nothing created" up_no_write
  case_done

  up_case "no ceiling"
  up_run ""
  check "upstream without a ceiling: nothing created" up_no_write
  check "upstream without a ceiling: recorded" up_decision 'no autonomy ceiling'
  case_done

  up_case "off switch after two invalid closures"
  mkdir -p "$T/state/upstream/$UPSLUG"
  now=$(date +%s)
  for k in 10 9; do
    printf '%s\t-\tfiled\th%s\thttps://github.com/up/tool/issues/%s\told %s\n' "$((now - k * 86400))" "$k" "$k" "$k" >> "$(up_ledger)"
    printf '{"state":"CLOSED","stateReason":"NOT_PLANNED","labels":[]}\n' > "$T/fake/gh/up-issue-up_tool-$k.json"
  done
  (cd "$REPO_ROOT" && PATH="$E2E_DIR/fakes:$PATH" FAKE_DIR="$T/fake" STATE_DIR="$T/state" bin/upstream-check check "$UP" > "$T/check.out" 2>&1)
  check "upstream breaker: upstream-check tripped (exit 10)" test "$?" = 10
  check "upstream breaker: the off file exists" test -s "$T/state/upstream/$UPSLUG/off"
  up_run auto
  check "upstream breaker: filing stops" up_no_write
  check "upstream breaker: the reason says switched off" up_decision 'switched off'
  rm -f "$T/state/upstream/$UPSLUG/off" "$T/state/upstream/$UPSLUG/ledger.tsv"
  up_run auto
  check "upstream breaker: after a reset the finding files" up_created
  case_done

  say "-- upstream: the tend-repo hook --"
  local tf='[{"title":"Own bug","body":"b","confidence":"high","evidence":"x","issue":true}]'
  local uf='{"title":"Tool crashes on an empty config","upstream":"up/tool","evidence":{"command":"tool run","versions":"tool 1.2.3","log":"panic: nil map","expected":"an error"}}'
  local uf2='{"title":"Other crash","upstream":"other/thing","evidence":{"command":"tool run","versions":"tool 1.2.3","log":"panic: nil map","expected":"an error"}}'
  case_new "tend upstream hook"
  FAKE_TEND_FINDING="$tf" FAKE_UPSTREAM_FINDING="$uf" run_wf tend-repo repo=$REPO auto_merge=false autonomy=auto "upstream=$UP=2"
  check "tend hook: the run succeeds" test "$RC" = 0
  check "tend hook: the scout ran" agent_ran scout
  check "tend hook: the issue went to the upstream" up_created
  check "tend hook: the subject is recorded in raised.txt as upstream" grep -q '^upstream	Tool crashes' "$T/state/tend/$REPO/raised.txt"
  case_done

  case_new "tend upstream hook, unlisted target"
  FAKE_TEND_FINDING="$tf" FAKE_UPSTREAM_FINDING="$uf2" run_wf tend-repo repo=$REPO auto_merge=false autonomy=auto "upstream=$UP=2"
  check "tend hook unlisted: nothing on any upstream" gh_none '^gh issue create --repo (up|other)/'
  check "tend hook unlisted: the own finding is filed as before" gh_once "^gh issue create --repo $REPO"
  case_done

  case_new "tend upstream hook below auto"
  FAKE_TEND_FINDING="$tf" FAKE_UPSTREAM_FINDING="$uf" run_wf tend-repo repo=$REPO auto_merge=false autonomy=act "upstream=$UP=2"
  check "tend hook at act: the scout never runs" agent_idle scout
  check "tend hook at act: nothing upstream" gh_none '^gh issue create --repo up/'
  case_done

  say "-- upstream: tend-repo with no upstream key equals the run before the feature --"
  local base=$E2E_TMP/up-baseline-wf which
  if ! git rev-parse --verify -q "$UPSTREAM_BASE_REV^{commit}" >/dev/null; then
    say "SKIP  upstream baseline: $UPSTREAM_BASE_REV is not in this clone"
    return
  fi
  rm -rf "$base"
  mkdir -p "$base"
  git archive "$UPSTREAM_BASE_REV" workflows | tar -x -C "$base"
  for which in old new; do
    if [ "$which" = old ]; then case_new "tend baseline old" "$base/workflows"; else case_new "tend baseline new"; fi
    FAKE_TEND_FINDING="$tf" run_wf tend-repo repo=$REPO auto_merge=false autonomy=act
    {
      echo "rc=$RC"
      norm_log
      echo "--- posted"
      for f in "$T/fake/posted/"*; do [ -f "$f" ] && { basename "$f" | sed 's/^[0-9]*-//'; cat "$f"; }; done
      echo "--- state"
      (cd "$T/state" && find . -type f ! -name '*.lock' | grep -vE '\.fake-|/work/|push\.log' | sort)
      echo "--- raised"
      cat "$T/state/tend/$REPO/raised.txt" 2>/dev/null
      echo "--- agents"
      sort "$T/fake/agent.steps"
    } > "$E2E_TMP/ub.$which"
    case_done
  done
  check "tend baseline: no upstream key, the run equals the one before (calls, bodies, state, agents)" cmp -s "$E2E_TMP/ub.old" "$E2E_TMP/ub.new"
  check "tend baseline: the compared record shows the own issue" grep -q 'gh issue create' "$E2E_TMP/ub.new"
  cmp -s "$E2E_TMP/ub.old" "$E2E_TMP/ub.new" || diff "$E2E_TMP/ub.old" "$E2E_TMP/ub.new" | head -20
}

# ---------------------------------------------------------------- identity ---
# Marked bodies (ADR 0034, docs/identity.md): what reaches the fake forge carries
# the dot marker when marking is on, is byte for byte the legacy body when it is
# off or empty, and a pull request under the dot's login without the marker is
# not the dot's to merge.
MARK='<!-- opencode-dots:dot='
posted_all() { cat "$T/fake/posted/"* 2>/dev/null; }
marks() { posted_all | grep -c -- "$MARK" || true; }

# identity_record SCENARIO [INPUT...]: run a scenario, write its record (calls and bodies)
identity_record() {
  local scen=$1
  shift
  case_new "identity $scen $*"
  case "$scen" in
    fix-patch) FAKE_FIX=patch FAKE_CLASS=1 run_wf fix-issue repo=$REPO issue=7 autonomy=auto "$@" ;;
    fix-decline) FAKE_FIX=decline FAKE_CLASS=1 run_wf fix-issue repo=$REPO issue=7 autonomy=auto "$@" ;;
    review) seed_pr 7 fix/7-20260101-0000 "$LOGIN"
            FAKE_REVIEW=clean-merge run_wf review-pr repo=$REPO pr=7 "sha=$PR_SHA" autonomy=auto "$@" ;;
  esac
  {
    echo "rc=$RC"
    norm_log | sed -E 's/[0-9a-f]{40}/<sha>/g'
    echo "--- posted"
    for f in "$T/fake/posted/"*; do [ -f "$f" ] && { basename "$f" | sed 's/^[0-9]*-//'; cat "$f"; }; done
  } > "$E2E_TMP/id.rec"
}

section_identity() {
  say "== identity: signed bodies, byte-identical when off =="
  local mode scen
  for mode in marker signed; do
    case_new "identity fix patch $mode"
    FAKE_FIX=patch FAKE_CLASS=1 run_wf fix-issue repo=$REPO issue=7 autonomy=auto identity=$mode
    check "identity $mode, fix-issue: run succeeds" test "$RC" = 0
    check "identity $mode, fix-issue: one pull request" gh_once '^gh pr create'
    check "identity $mode, fix-issue: the pull request body carries one marker" test "$(marks)" = 1
    check "identity $mode, fix-issue: the marker names the workflow" grep -q "dot=.*:fix-issue:7 -->" "$T/fake/posted/"*pr-create.md
    check "identity $mode, fix-issue: Closes #7 is still in the body" grep -q 'Closes #7' "$T/fake/posted/"*pr-create.md
    check "identity $mode, fix-issue: the title is untouched" gh_some ' --title Fix the crash'
    if [ "$mode" = signed ]; then
      check "identity signed, fix-issue: a visible footer" grep -q 'Filed by an automated agent (the dot `' "$T/fake/posted/"*pr-create.md
    else
      check "identity marker, fix-issue: no visible footer" bash -c "! grep -q 'automated agent' $T/fake/posted/*pr-create.md"
    fi
    case_done
    case_new "identity fix decline $mode"
    FAKE_FIX=decline FAKE_CLASS=1 run_wf fix-issue repo=$REPO issue=7 autonomy=auto identity=$mode
    check "identity $mode, fix-issue decline: the issue comment carries the marker" grep -q -- "$MARK" "$T/fake/posted/"*issue-comment.md
    check "identity $mode, fix-issue decline: the answer text is kept" grep -q 'already fixed' "$T/fake/posted/"*issue-comment.md
    case_done
    case_new "identity review $mode"
    seed_pr 7 fix/7-20260101-0000 "$LOGIN"
    FAKE_REVIEW=clean-merge run_wf review-pr repo=$REPO pr=7 "sha=$PR_SHA" autonomy=auto identity=$mode
    check "identity $mode, review-pr: the review comment carries one marker" test "$(marks)" = 1
    check "identity $mode, review-pr: posted once" gh_once '^gh pr comment 7'
    case_done
  done
  case_new "identity propose holds the signed body"
  FAKE_FIX=decline FAKE_CLASS=1 run_wf fix-issue repo=$REPO issue=7 autonomy=propose identity=signed
  check "identity propose: the held artifact is the signed one" bash -c "grep -q -- '$MARK' \$(sed -n 's/^artifact: //p' $T/state/held/*-comment-*)"
  case_done

  for scen in fix-patch fix-decline review; do
    identity_record "$scen"
    cp "$E2E_TMP/id.rec" "$E2E_TMP/id.$scen.legacy"; case_done
    identity_record "$scen" identity=
    cp "$E2E_TMP/id.rec" "$E2E_TMP/id.$scen.empty"; case_done
    identity_record "$scen" identity=off
    cp "$E2E_TMP/id.rec" "$E2E_TMP/id.$scen.off"; case_done
    check "identity $scen: identity= is byte-identical to no input (calls and bodies)" cmp -s "$E2E_TMP/id.$scen.legacy" "$E2E_TMP/id.$scen.empty"
    check "identity $scen: identity=off is byte-identical to no input (calls and bodies)" cmp -s "$E2E_TMP/id.$scen.legacy" "$E2E_TMP/id.$scen.off"
    check "identity $scen: the legacy record has a body" grep -q -- '--- posted' "$E2E_TMP/id.$scen.legacy"
    check "identity $scen: the legacy record has no marker" bash -c "! grep -q -- '$MARK' $E2E_TMP/id.$scen.legacy"
  done

  say "== identity: the merge scope tells the dot's pull request from a human's =="
  local human='A human wrote this.

Closes #7' dotbody='Fixes the crash.

Closes #7

<!-- opencode-dots:dot=tester:fix-issue:7 -->'
  case_new "identity human PR, marking on"
  seed_pr 7 fix/7-20260101-0000 "$LOGIN" "$human"
  FAKE_REVIEW=clean-merge run_wf review-pr repo=$REPO pr=7 "sha=$PR_SHA" autonomy=auto identity=marker
  check "human pull request under the dot's login, marking on, auto: not merged" gh_none '^gh pr merge'
  check "human pull request, marking on: the refusal names the missing marker" grep -q 'no dot marker' "$T/out.log"
  check "human pull request, marking on: the run itself succeeds" test "$RC" = 0
  case_done
  case_new "identity human PR, marking off"
  seed_pr 7 fix/7-20260101-0000 "$LOGIN" "$human"
  FAKE_REVIEW=clean-merge run_wf review-pr repo=$REPO pr=7 "sha=$PR_SHA" autonomy=auto
  check "same pull request, marking off: merged as before" gh_once '^gh pr merge 7'
  case_done
  case_new "identity human PR, identity=off"
  seed_pr 7 fix/7-20260101-0000 "$LOGIN" "$human"
  FAKE_REVIEW=clean-merge run_wf review-pr repo=$REPO pr=7 "sha=$PR_SHA" autonomy=auto identity=off
  check "same pull request, identity=off: merged as before" gh_once '^gh pr merge 7'
  case_done
  for mode in marker signed; do
    case_new "identity dot PR, $mode"
    seed_pr 7 fix/7-20260101-0000 "$LOGIN" "$dotbody"
    FAKE_REVIEW=clean-merge run_wf review-pr repo=$REPO pr=7 "sha=$PR_SHA" autonomy=auto identity=$mode
    check "the dot's marked pull request, $mode, auto: merged once" gh_once '^gh pr merge 7'
    case_done
  done
  case_new "identity human PR, marking on, scope all"
  seed_pr 7 fix/7-20260101-0000 "$LOGIN" "$human"
  GATE_MERGE_SCOPE=all FAKE_REVIEW=clean-merge run_wf review-pr repo=$REPO pr=7 "sha=$PR_SHA" autonomy=auto identity=marker
  check "human pull request, marking on, GATE_MERGE_SCOPE=all: merged" gh_once '^gh pr merge 7'
  case_done
  case_new "identity human PR, marking on, act"
  seed_pr 7 fix/7-20260101-0000 "$LOGIN" "$human"
  FAKE_REVIEW=clean-merge run_wf review-pr repo=$REPO pr=7 "sha=$PR_SHA" autonomy=act identity=marker
  check "human pull request, marking on, act: no merge" gh_none '^gh pr merge'
  check "human pull request, marking on, act: the review is still commented" gh_once '^gh pr comment 7'
  case_done

  say "== identity: the generator refuses an unmarked client repository =="
  local rd=$E2E_TMP/idrepos out
  mkdir -p "$rd"
  for mode in "" "identity: off" "identity: marker"; do
    cat > "$rd/repos.yaml" <<YAML
version: 1
settings:
  trust: {host: client, allow: {providers: [opencode], models: [mistral/small-latest], executors: [server]}}
  executors: {server: http://127.0.0.1:2512}
repos:
  acme/app:
    trust: client
    executor: server
    review: true
    $mode
YAML
    (cd "$REPO_ROOT" && go run ./cmd/repos check -dir "$rd") > "$rd/out" 2>&1 || true
    case "$mode" in
      "identity: marker") check "client repository with identity: marker is accepted" bash -c "! grep -q 'needs marker or signed' $rd/out" ;;
      *) check "client repository with '${mode:-no identity}' is refused" grep -q "needs marker or signed" "$rd/out" ;;
    esac
  done
}

# -------------------------------------------------------------------- race --
# Two runs on two pull requests of one repository share one clone. The old
# workflows read the clone's fetch-head file after their fetch, so a run could
# check out the other one's commit. A git shim sleeps after each fetch to widen
# the window, so the race is provoked on purpose. RACE_WF_DIR points the test at
# another set of workflows (to show it fails on the old ones).
section_race() {
  say "== race: two review-pr runs on one clone, at the same time =="
  local wf i n sha sha7 sha8 pids shimdir=$E2E_TMP/gitshim real
  for wf in review-pr reply-pr fix-ci fix-issue tend-repo; do
    check "$wf never reads the shared fetch-head file" bash -c "! grep -q FETCH_HEAD '${RACE_WF_DIR:-workflows}/$wf.yaml'"
  done
  real=$(command -v git)
  mkdir -p "$shimdir"
  cat > "$shimdir/git" <<SHIM
#!/usr/bin/env bash
"$real" "\$@"; rc=\$?
case " \$* " in *" fetch "*) sleep "0.\$((RANDOM % 4 + 2))" ;; esac
exit \$rc
SHIM
  chmod +x "$shimdir/git"
  for i in 1 2 3 4 5; do
    case_new "race $i" "${RACE_WF_DIR:-$REPO_ROOT/workflows}"
    seed_pr 7 fix/7-20260101-0000 "$LOGIN"; sha7=$PR_SHA
    # A later date makes the second commit differ from the first (same tree).
    GIT_AUTHOR_DATE=2026-01-02T00:00:00Z GIT_COMMITTER_DATE=2026-01-02T00:00:00Z seed_pr 8 feature/other "$LOGIN"; sha8=$PR_SHA
    # One clone for both, made before they start so they do not race to clone.
    mkdir -p "$T/work/tester"
    git clone -q --filter=blob:none --no-checkout "https://github.com/$REPO.git" "$T/work/$REPO" 2>/dev/null
    pids=()
    for n in 7 8; do
      sha=$sha7; [ "$n" = 8 ] && sha=$sha8
      (
        sleep "0.$((RANDOM % 3))"
        cd "$T/proj" || exit 99
        export PATH="$shimdir:$E2E_DIR/fakes:$PATH" HOME="$T/home" FAKE_DIR="$T/fake" \
          STATE_DIR="$T/state" WORK_ROOT="$T/work" REPOS_MAP="$T/repos.map" DOTS_HOME="$T/dots" \
          GIT_CONFIG_GLOBAL="$T/gitconfig" GIT_CONFIG_SYSTEM=/dev/null GIT_ALLOW_PROTOCOL=file \
          GIT_TERMINAL_PROMPT=0 CI_WAIT_SECONDS=2 FAKE_REVIEW=clean-merge
        unset DISCORD_WEBHOOK GH_TOKEN GITHUB_TOKEN
        awf run review-pr --storage "$T/awf$n" --output buffered \
          --input repo=$REPO --input pr=$n --input "sha=$sha" > "$T/out.$n.log" 2>&1
      ) &
      pids+=($!)
    done
    wait "${pids[@]}"
    # The fetch step prints the HEAD of the work tree it made; the tree itself is
    # removed when the run ends.
    check "race $i: run 7 work HEAD is its own pull request" test "$(sed -n 's/.*checked out \([0-9a-f]\{40\}\).*/\1/p' "$T/out.7.log")" = "$sha7"
    check "race $i: run 8 work HEAD is its own pull request" test "$(sed -n 's/.*checked out \([0-9a-f]\{40\}\).*/\1/p' "$T/out.8.log")" = "$sha8"
    check "race $i: no private fetch ref left in the clone" test -z "$(git -C "$T/work/$REPO" for-each-ref refs/dots)"
    case_done
  done
}

# ------------------------------------------------------------------ budget ---
# The daily cap (ADR 0036, docs/budget.md): a fake bin/budget answers the exit code, the real
# gate and workflows act on it. With no budget input nothing changes, byte for byte.
BUDGET=daily_usd=5
budget_called() { [ -s "$T/fake/budget.log" ]; }
budget_calls() { wc -l < "$T/fake/budget.log" 2>/dev/null || echo 0; }

# budget_record SCENARIO [INPUT...]: a legacy-shaped run, its calls and bodies, for cmp.
budget_record() {
  local scen=$1
  shift
  case_new "budget $scen $*"
  case "$scen" in
    fix-patch) FAKE_FIX=patch FAKE_CLASS=1 run_wf fix-issue repo=$REPO issue=7 "$@" ;;
    fix-act) FAKE_FIX=patch FAKE_CLASS=1 run_wf fix-issue repo=$REPO issue=7 autonomy=act "$@" ;;
    review) seed_pr 7 fix/7-20260101-0000 "$LOGIN"
            FAKE_REVIEW=clean-merge run_wf review-pr repo=$REPO pr=7 "sha=$PR_SHA" "$@" ;;
    review-auto) seed_pr 7 fix/7-20260101-0000 "$LOGIN"
            FAKE_REVIEW=clean-merge run_wf review-pr repo=$REPO pr=7 "sha=$PR_SHA" autonomy=auto "$@" ;;
    tend) FAKE_TEND_FINDING='[{"title":"Own bug","body":"b","confidence":"high","evidence":"x","issue":true}]' \
            run_wf tend-repo repo=$REPO auto_merge=false autonomy=act "$@" ;;
  esac
  {
    echo "rc=$RC"
    norm_log | sed -E 's/[0-9a-f]{40}/<sha>/g'
    echo "--- posted"
    for f in "$T/fake/posted/"*; do [ -f "$f" ] && { basename "$f" | sed 's/^[0-9]*-//'; cat "$f"; }; done
    echo "--- state"
    (cd "$T/state" && find . -type f ! -name '*.lock' | grep -vE '\.fake-|/work/|\.json$|push\.log' | sed -E 's#(pr[0-9]+-)[0-9a-f]{40}#\1<sha>#' | sort)
    echo "--- agents"
    sort "$T/fake/agent.steps"
  } > "$E2E_TMP/bg.rec"
}

section_budget() {
  say "== budget: the daily cap stops autonomous work, nothing changes without it =="
  local rc label ceil a

  # fix-issue: a reached cap stops the run before the checkout and every agent step.
  for rc in 3 1; do
    for ceil in legacy act; do
      label="budget fix-issue, cap reached (budget exit $rc), $ceil"
      case_new "$label"
      a=(repo=$REPO issue=7 "budget=$BUDGET")
      [ "$ceil" = legacy ] || a+=("autonomy=$ceil")
      FAKE_BUDGET_RC=$rc FAKE_FIX=patch FAKE_CLASS=1 run_wf fix-issue "${a[@]}"
      check "$label: the run succeeds" test "$RC" = 0
      check "$label: no agent step ran, nothing was spent" test ! -s "$T/fake/agent.steps"
      check "$label: no checkout was made" test ! -e "$T/state/fix/$REPO/issue-7"
      check "$label: nothing pushed, no pull request, no comment" bash -c "source $E2E_DIR/lib.sh; T=$T; no_push_no_pr && ! grep -q '^gh issue comment' $T/fake/gh.log"
      check "$label: no gh call at all" test ! -s "$T/fake/gh.log"
      check "$label: one note says the budget is reached" bash -c "[ $(note_of push) = 1 ] && grep -q 'reason: daily budget reached' $T/state/notes/*"
      check "$label: bin/budget was asked once with the repository and the cap" bash -c "[ $(budget_calls) = 1 ] && grep -qx 'budget check $REPO $BUDGET' $T/fake/budget.log"
      case_done
    done
  done

  # fix-issue: under the cap the run goes on and publishes; the cap is read again before the push.
  for ceil in legacy act auto; do
    label="budget fix-issue, under the cap, $ceil"
    case_new "$label"
    a=(repo=$REPO issue=7 "budget=$BUDGET")
    [ "$ceil" = legacy ] || a+=("autonomy=$ceil")
    FAKE_BUDGET_RC=0 FAKE_FIX=patch FAKE_CLASS=1 run_wf fix-issue "${a[@]}"
    check "$label: the run succeeds" test "$RC" = 0
    check "$label: branch pushed, one pull request" bash -c "source $E2E_DIR/lib.sh; T=$T; has_branch 'fix/7-*' && gh_once '^gh pr create'"
    check "$label: no note" test "$(n_files "$T/state/notes" '*')" = 0
    check "$label: asked at the start and again before the push" test "$(budget_calls)" = 2
    case_done
  done

  case_new "budget fix-issue, reached during the run"
  FAKE_BUDGET_RCS="0 3" FAKE_FIX=patch FAKE_CLASS=1 run_wf fix-issue repo=$REPO issue=7 "budget=$BUDGET" autonomy=act
  check "budget fix-issue mid-run: the run succeeds" test "$RC" = 0
  check "budget fix-issue mid-run: the agent ran (the cap was open at the start)" agent_ran fix
  check "budget fix-issue mid-run: nothing pushed, no pull request" no_push_no_pr
  check "budget fix-issue mid-run: the push is a note, daily budget reached" bash -c "[ $(note_of push) = 1 ] && grep -q 'reason: daily budget reached' $T/state/notes/*"
  case_done

  case_new "budget fix-issue, reached during the run, no ceiling"
  FAKE_BUDGET_RCS="0 3" FAKE_FIX=patch FAKE_CLASS=1 run_wf fix-issue repo=$REPO issue=7 "budget=$BUDGET"
  check "budget fix-issue mid-run, no ceiling: the cap holds without a ceiling" no_push_no_pr
  check "budget fix-issue mid-run, no ceiling: one note" test "$(note_of push)" = 1
  case_done

  # review-pr: the review comment still goes out; push and merge become notes.
  for ceil in legacy auto; do
    label="budget review-pr merge, cap reached, $ceil"
    case_new "$label"
    seed_pr 7 fix/7-20260101-0000 "$LOGIN"
    a=(repo=$REPO pr=7 "sha=$PR_SHA" "budget=$BUDGET")
    [ "$ceil" = legacy ] || a+=("autonomy=$ceil")
    FAKE_BUDGET_RC=3 FAKE_REVIEW=clean-merge run_wf review-pr "${a[@]}"
    check "$label: the run succeeds" test "$RC" = 0
    check "$label: the review is still commented" gh_once '^gh pr comment 7'
    check "$label: no merge" gh_none '^gh pr merge'
    check "$label: the merge is a note, daily budget reached" bash -c "[ $(note_of merge) = 1 ] && grep -q 'reason: daily budget reached' $T/state/notes/*merge*"
    case_done
  done

  case_new "budget review-pr fix round, cap reached, act"
  seed_pr 7 fix/7-20260101-0000 "$LOGIN"
  FAKE_BUDGET_RC=3 FAKE_REVIEW=finding-then-merge run_wf review-pr repo=$REPO pr=7 "sha=$PR_SHA" autonomy=act "budget=$BUDGET"
  check "budget review-pr fix round: the fix is not pushed" bash -c "! git -C $T/remotes/tester/demo.git show fix/7-20260101-0000:src.txt | grep -q cleared"
  check "budget review-pr fix round: the push is a note" test "$(note_of push)" = 1
  check "budget review-pr fix round: the review comment is not held, it goes out" gh_some '^gh pr comment 7'
  case_done

  label="budget review-pr merge, under the cap, auto"
  case_new "$label"
  seed_pr 7 fix/7-20260101-0000 "$LOGIN"
  FAKE_BUDGET_RC=0 FAKE_REVIEW=clean-merge run_wf review-pr repo=$REPO pr=7 "sha=$PR_SHA" autonomy=auto "budget=$BUDGET"
  check "$label: merged once" gh_once '^gh pr merge 7'
  check "$label: no note" test "$(n_files "$T/state/notes" '*')" = 0
  case_done

  # tend-repo: an own issue is still filed (a comment, allowed); the flag is kept for the gate steps.
  local tf='[{"title":"Own bug","body":"b","confidence":"high","evidence":"x","issue":true}]'
  case_new "budget tend-repo, cap reached"
  FAKE_BUDGET_RC=3 FAKE_TEND_FINDING="$tf" run_wf tend-repo repo=$REPO auto_merge=false autonomy=act "budget=$BUDGET"
  check "budget tend-repo: the run succeeds" test "$RC" = 0
  check "budget tend-repo: the issue is still filed" gh_once "^gh issue create --repo $REPO"
  check "budget tend-repo: the flag is written" test "$(cat "$T/state/tend/$REPO/budget_over")" = 1
  check "budget tend-repo: asked once" test "$(budget_calls)" = 1
  case_done
  case_new "budget tend-repo, under the cap"
  FAKE_BUDGET_RC=0 FAKE_TEND_FINDING="$tf" run_wf tend-repo repo=$REPO auto_merge=false autonomy=act "budget=$BUDGET"
  check "budget tend-repo under: no flag" test ! -e "$T/state/tend/$REPO/budget_over"
  case_done

  say "-- budget: an unset or empty budget input is byte-identical, and bin/budget is never run --"
  local scen
  for scen in fix-patch fix-act review review-auto tend; do
    budget_record "$scen"
    cp "$E2E_TMP/bg.rec" "$E2E_TMP/bg.$scen.none"
    check "budget $scen, no input: bin/budget never ran" bash -c "[ ! -e $T/fake/budget.log ]"
    case_done
    FAKE_BUDGET_RC=3 budget_record "$scen" budget=
    cp "$E2E_TMP/bg.rec" "$E2E_TMP/bg.$scen.empty"
    check "budget $scen, empty input: bin/budget never ran even where it would say reached" bash -c "[ ! -e $T/fake/budget.log ]"
    case_done
    check "budget $scen: budget= is byte-identical to no input (calls, bodies, state, agents)" cmp -s "$E2E_TMP/bg.$scen.none" "$E2E_TMP/bg.$scen.empty"
    check "budget $scen: the compared record is not empty" test "$(wc -l < "$E2E_TMP/bg.$scen.none")" -gt 5
    cmp -s "$E2E_TMP/bg.$scen.none" "$E2E_TMP/bg.$scen.empty" || diff "$E2E_TMP/bg.$scen.none" "$E2E_TMP/bg.$scen.empty" | head -20
  done

  say "-- budget: a malformed input is rejected by awf --"
  case_new "budget bad input"
  run_wf fix-issue repo=$REPO issue=7 "budget=daily_usd=lots"
  check "budget bad input: awf rejects it" test "$RC" != 0
  check "budget bad input: nothing ran" test ! -s "$T/fake/gh.log"
  case_done
}

want fix-issue && section_fix_issue
want race && section_race
want classify && section_classify
want review && section_review
want held && section_held
want baseline && section_baseline
want upstream && section_upstream
want identity && section_identity
want budget && section_budget
summary
