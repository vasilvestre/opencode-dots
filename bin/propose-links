#!/usr/bin/env bash
# One _propose-links run per workspace named in $STATE_DIR/propose-links.list (ADR 0041,
# docs/links.md). Opt-in: with no such file, or an empty one, nothing runs. The workflow only
# inserts `open` link proposals, which a person decides in the dashboard, so no autonomy
# ceiling applies. Dispatched through awf serve so the run lands in its history, never `awf run`.
#
#   STATE_DIR              where propose-links.list lives (default state under the repo).
#   PROPOSE_LINKS_LIST     the list (default $STATE_DIR/propose-links.list): one workspace per line.
#   PROPOSE_LINKS_MAX      max_pairs input, 1 to 50 (default: the workflow's own).
#   REPOS_BIN              the repos binary (default bin/repos).
#   AWF_URL                awf serve (default http://127.0.0.1:2511).
#   PROPOSE_LINKS_TIMEOUT  seconds to wait for one run (default 3600).
#
# A workspace the database does not know (no repository under it) is skipped with a message.
# Exit 0 when nothing is wrong or there is nothing to do, 1 when awf cannot be reached or a run fails.
set -euo pipefail
cd "$(dirname "$0")/.."

state=${STATE_DIR:-$(pwd)/state}
export STATE_DIR=$state
list=${PROPOSE_LINKS_LIST:-$state/propose-links.list}
awf_api=${AWF_URL:-http://127.0.0.1:2511}
repos=${REPOS_BIN:-bin/repos}
max=${PROPOSE_LINKS_MAX:-}

if [ ! -f "$list" ]; then
  echo "no $list, nothing to propose"
  exit 0
fi
if [ -n "$max" ] && [[ ! $max =~ ^([1-9]|[1-4][0-9]|50)$ ]]; then
  echo "propose-links: PROPOSE_LINKS_MAX must be 1 to 50" >&2
  exit 2
fi

failed=0
while read -r ws rest; do
  case "$ws" in ''|'#'*) continue ;; esac
  if [ -n "$rest" ] || [[ ! $ws =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
    echo "skip invalid workspace line: $ws $rest" >&2
    continue
  fi
  if [ -z "$("$repos" db list -workspace "$ws" 2>/dev/null)" ]; then
    echo "skip $ws: no repository under that workspace in the database"
    continue
  fi

  echo "== $ws"
  body=$(jq -nc --arg ws "$ws" --arg max "$max" \
    '{inputs:({workspace:$ws} + (if $max != "" then {max_pairs:$max} else {} end))}')
  if ! resp=$(curl -s -w '\n%{http_code}' -X POST "$awf_api/api/workflows/local/_propose-links/run" \
      -H 'Content-Type: application/json' -d "$body"); then
    echo "propose-links: cannot reach awf at $awf_api: is awf serve running (systemctl --user status dots-awf, or make up)?" >&2
    exit 1
  fi
  code=${resp##*$'\n'}
  resp=${resp%$'\n'*}
  case "$code" in
    2??) ;;
    *) echo "propose-links: awf answered HTTP $code for $ws: $resp" >&2; failed=1; continue ;;
  esac
  id=$(printf '%s' "$resp" | jq -r '.body.execution_id // empty')
  if [ -z "$id" ]; then
    echo "propose-links: dispatch refused for $ws: $resp" >&2
    failed=1
    continue
  fi
  deadline=$(( $(date +%s) + ${PROPOSE_LINKS_TIMEOUT:-3600} ))
  while :; do
    status=$(curl -sf "$awf_api/api/executions/$id" | jq -r '.body.status // empty')
    case "$status" in
      running|pending) ;;
      completed) echo "propose-links: $ws done"; break ;;
      "") echo "propose-links: lost execution $id" >&2; failed=1; break ;;
      *) echo "propose-links: $ws ended $status" >&2; failed=1; break ;;
    esac
    if [ "$(date +%s)" -ge "$deadline" ]; then
      echo "propose-links: $ws timed out after ${PROPOSE_LINKS_TIMEOUT:-3600}s" >&2
      failed=1
      break
    fi
    sleep "${PROPOSE_LINKS_POLL:-10}"
  done
done < "$list"
exit "$failed"
