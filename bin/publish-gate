#!/usr/bin/env bash
# The one choke point between a workflow and GitHub (ADR 0040, ADR 0002). A shell
# step calls it before it comments, pushes, opens a pull request or merges. The
# agent never calls it and cannot skip it: it runs in shell steps only.
#
#   bin/publish-gate ACTION        ACTION: comment | push | open-pr | merge | file-issue
#
# Environment:
#   AUTONOMY       observe | propose | act | auto. Empty: legacy, allow everything.
#   ITEM_CLASS     1, 2 or 3 (ADR 0040). Empty: not classified, only the ceiling counts.
#   STATE_DIR      where held items and notes go (default /state).
#   GATE_REF       what is being published, e.g. OWNER/REPO#N (for the trace).
#   GATE_REPO      OWNER/REPO, to look up a tripped circuit breaker (default: from GATE_REF).
#   GATE_ARTIFACT  path of the prepared comment, patch or text (for the trace).
#                  A held or note record keeps its own copy under held/artifacts/<record name>/
#                  (or notes/artifacts/...): `artifact:` names the copy, `source:` the original
#                  (cap GATE_ARTIFACT_CAP bytes, default 5242880; above it no copy is made).
#   GATE_BRANCH, GATE_BASE, GATE_PUSH_REPO, GATE_TITLE, GATE_CLOSES
#                  optional: written into a held record as `branch`, `base`, `push-repo`,
#                  `title`, `closes` so workflows/publish-held.yaml can release it
#                  (docs/publish-held.md). A value is cut to one line, control characters dropped.
#   GATE_TARGET   file-issue only: the upstream OWNER/REPO the issue is for. Written into a held
#                  record as `target:` (ADR 0043, docs/upstream.md).
#   GATE_REPO_SOURCE, GATE_UPSTREAM
#                  file-issue only: the repository the finding comes from and the upstream
#                  it is for. Written into a held record as `repo:` and `upstream:`, so
#                  workflows/publish-held.yaml need not derive them.
#   GATE_PR_AUTHOR login of the pull request author, for a merge at auto (ADR 0040).
#   DOT_LOGIN      the dot's own login (default: the login `gh` is signed in as).
#   GATE_MERGE_SCOPE  own (default) | all. At auto a merge is allowed for pull requests the dot
#                  wrote or a dependency bot wrote (dependabot, renovate, github-actions);
#                  `all` widens it to every author. An unknown author is not `own`.
#   GATE_BUDGET_OVER  1 when the repository's daily budget is reached (a caller sets it after
#                  bin/budget check, docs/budget.md): push, open-pr, merge and file-issue become a
#                  note ("daily budget reached", exit 4) whatever the ceiling, even with none;
#                  comment is unaffected. Empty or 0: nothing changes.
#   GATE_IDENTITY  off (or empty) | marker | signed: the repository's marking mode (ADR 0034,
#                  docs/identity.md). With marking on, a pull request by DOT_LOGIN is the dot's own
#                  only if its body carries the dot marker, which the caller checks and reports
#                  as GATE_PR_BODY_MARKED=1; else it is a human's under the same login and a merge
#                  at auto is refused. With marking off nothing changes.
#
# Exit codes, the reason always goes to stderr:
#   0 allow      the step goes on.
#   3 hold       propose: the artifact reference is written under $STATE_DIR/held/.
#   4 note only  observe, class 3 or a reached daily budget: an internal note is written under $STATE_DIR/notes/.
#   5 refused    the action is never allowed here (an emergency stop, a merge below auto, a class 2 merge,
#                a merge of someone else's pull request, file-issue below auto, an unknown value).
# The caller treats every non-zero code as "do not publish" and exits 0 itself.
set -euo pipefail

action=${1:-}
case "$action" in
  comment|push|open-pr|merge|file-issue) ;;
  *) echo "publish-gate: unknown action '$action' (comment, push, open-pr, merge, file-issue)" >&2; exit 5 ;;
esac

level=${AUTONOMY:-}
class=${ITEM_CLASS:-}
ref=${GATE_REF:-unknown}
artifact=${GATE_ARTIFACT:-}
state=${STATE_DIR:-/state}

# An emergency stop (bin/pause, docs/pause.md) refuses every action, before any ceiling is looked at.
pause_repo=${GATE_REPO:-}
if [ -z "$pause_repo" ]; then
  case "$ref" in */*#*) pause_repo=${ref%%#*} ;; esac
fi
if [ -e "$state/pause/all.json" ]; then
  echo "publish-gate: $action on $ref refused: the dot is stopped (bin/pause status)" >&2
  exit 5
fi
if [ -n "$pause_repo" ] && [ -e "$state/pause/${pause_repo/\//__}.json" ]; then
  echo "publish-gate: $action on $ref refused: $pause_repo is stopped (bin/pause status)" >&2
  exit 5
fi

budget_over=${GATE_BUDGET_OVER:-}
case "$budget_over" in
  ""|0|1) ;;
  *) echo "publish-gate: unknown GATE_BUDGET_OVER '$budget_over', $action refused" >&2; exit 5 ;;
esac
# A reached daily budget (bin/budget, docs/budget.md) stops what spends or publishes
# code; a comment still goes out.
budget_blocks=0
if [ "$budget_over" = 1 ]; then
  case "$action" in push|open-pr|merge|file-issue) budget_blocks=1 ;; esac
fi

if [ -z "$level" ] && [ "$budget_blocks" = 0 ]; then
  echo "publish-gate: no autonomy ceiling set, $action allowed" >&2
  exit 0
fi

case "$level" in
  observe|propose|act|auto|"") ;;
  *) echo "publish-gate: unknown autonomy '$level', $action refused" >&2; exit 5 ;;
esac
case "$class" in
  ""|1|2|3) ;;
  *) echo "publish-gate: unknown item class '$class', $action refused" >&2; exit 5 ;;
esac

# Write one small file saying what was not published and why. Failing to write it
# must not turn a hold into an allow, so the exit code is the caller's, not this.
record() { # DIR REASON
  local dir=$state/$1 slug file name shown src= size cdir leaf
  slug=$(printf '%s' "$ref" | tr -c 'A-Za-z0-9._-' '_')
  name=$(date -u +%Y%m%dT%H%M%SZ)-$action-$slug
  file=$dir/$name.txt
  shown=${artifact:-none}
  # The workflow's artifact lives in a directory the next run wipes. Keep a copy
  # under $dir/artifacts/<record name>/ and point the record at it; the original
  # path goes on a `source` line. A missing, empty or too large artifact (cap
  # GATE_ARTIFACT_CAP bytes, default 5 MiB) is not copied: the record keeps the
  # original path, as before.
  if [ -f "$artifact" ] && [ -s "$artifact" ]; then
    size=$(wc -c < "$artifact" 2>/dev/null || echo 0)
    if [ "$size" -le "${GATE_ARTIFACT_CAP:-5242880}" ]; then
      cdir=$dir/artifacts/$name
      leaf=$(printf '%s' "${artifact##*/}" | tr -c 'A-Za-z0-9._-' '_')
      if mkdir -p "$cdir" 2>/dev/null && cp -- "$artifact" "$cdir/$leaf" 2>/dev/null; then
        shown=$cdir/$leaf
        src=$artifact
      else
        rm -rf "$cdir" 2>/dev/null || true
      fi
    fi
  fi
  if mkdir -p "$dir" 2>/dev/null && {
    printf 'action: %s\nref: %s\nautonomy: %s\nclass: %s\nartifact: %s\n' \
      "$action" "$ref" "${level:-none}" "${class:-none}" "$shown"
    [ -z "$src" ] || printf 'source: %s\n' "$src"
    printf 'reason: %s\n' "$2"
    if [ "$1" = held ]; then
      local pair key var val
      for pair in branch:GATE_BRANCH base:GATE_BASE push-repo:GATE_PUSH_REPO title:GATE_TITLE closes:GATE_CLOSES target:GATE_TARGET repo:GATE_REPO_SOURCE upstream:GATE_UPSTREAM; do
        key=${pair%%:*}
        var=${pair#*:}
        val=$(printf '%s' "${!var:-}" | head -n 1 | tr -d '\000-\037\177')
        [ -z "$val" ] || printf '%s: %s\n' "$key" "$val"
      done
    fi
  } > "$file" 2>/dev/null; then
    echo "publish-gate: recorded $file" >&2
  else
    echo "publish-gate: could not write under $dir" >&2
  fi
}

note() { # REASON
  echo "publish-gate: $action on $ref is a note only: $1" >&2
  record notes "$1"
  exit 4
}

if [ "$budget_blocks" = 1 ]; then
  note "daily budget reached"
fi

# A tripped circuit breaker (bin/breaker, docs/breaker.md) lowers auto to act for this call.
if [ "$level" = auto ]; then
  repo=${GATE_REPO:-}
  if [ -z "$repo" ]; then
    case "$ref" in */*#*) repo=${ref%%#*} ;; esac
  fi
  if [ -n "$repo" ] && [ -e "$state/breaker/${repo/\//__}.json" ]; then
    echo "publish-gate: circuit breaker tripped for $repo, autonomy auto lowered to act (bin/breaker status; a person runs bin/breaker reset)" >&2
    level=act
  fi
fi

# Class 3 is a human diagnosis whatever the ceiling: an analysis, never a publication.
if [ "$class" = 3 ]; then
  note "class 3, a human diagnosis"
fi

case "$level" in
  observe)
    note "autonomy observe"
    ;;
  propose)
    if [ "$action" = merge ]; then
      echo "publish-gate: merge on $ref refused: autonomy propose never merges" >&2
      exit 5
    fi
    echo "publish-gate: $action on $ref held for a person: autonomy propose" >&2
    record held "autonomy propose"
    exit 3
    ;;
  act)
    if [ "$action" = file-issue ]; then
      echo "publish-gate: file-issue on $ref refused: writing on an upstream tracker needs auto" >&2
      exit 5
    fi
    if [ "$action" = merge ]; then
      echo "publish-gate: merge on $ref refused: autonomy act never merges" >&2
      exit 5
    fi
    ;;
  auto)
    if [ "$action" = merge ] && [ "$class" = 2 ]; then
      echo "publish-gate: merge on $ref refused: class 2 is never merged by the dot" >&2
      exit 5
    fi
    if [ "$action" = merge ] && [ "${GATE_MERGE_SCOPE:-own}" != all ]; then
      case "${GATE_MERGE_SCOPE:-own}" in
        own) ;;
        *) echo "publish-gate: unknown merge scope '$GATE_MERGE_SCOPE', merge refused" >&2; exit 5 ;;
      esac
      author=${GATE_PR_AUTHOR:-}
      bot=${author#app/}; bot=${bot%\[bot\]}
      case "$author" in
        "") echo "publish-gate: merge on $ref refused: the pull request author is unknown (GATE_MERGE_SCOPE=all widens it)" >&2; exit 5 ;;
        app/*|*\[bot\]) case "$bot" in dependabot|renovate|github-actions) bot=yes ;; *) bot=no ;; esac ;;
        *) bot=no ;;
      esac
      if [ "$bot" != yes ]; then
        me=${DOT_LOGIN:-$(gh api user --jq .login 2>/dev/null || true)}
        if [ -z "$me" ] || [ "$author" != "$me" ]; then
          echo "publish-gate: merge on $ref refused: $author wrote it, not the dot or a dependency bot (GATE_MERGE_SCOPE=all widens it)" >&2
          exit 5
        fi
        # Same login is not the same writer: with marking on, the dot's own pull request says so.
        case "${GATE_IDENTITY:-off}" in
          ""|off) ;;
          marker|signed)
            if [ "${GATE_PR_BODY_MARKED:-}" != 1 ]; then
              echo "publish-gate: merge on $ref refused: $author is the dot's login but the pull request body has no dot marker, so it is treated as a human's (identity $GATE_IDENTITY; GATE_MERGE_SCOPE=all widens it)" >&2
              exit 5
            fi ;;
          *) echo "publish-gate: unknown identity '$GATE_IDENTITY', merge refused" >&2; exit 5 ;;
        esac
      fi
    fi
    ;;
esac

echo "publish-gate: $action on $ref allowed (autonomy $level, class ${class:-none})" >&2
exit 0
