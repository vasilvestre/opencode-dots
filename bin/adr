#!/usr/bin/env bash
# Create and keep ADR/ consistent. `check` is the only guard: numbering, the
# index row, and the supersede links must agree.
set -euo pipefail
cd "$(dirname "$0")/.."
dir=ADR
readme=$dir/README.md

die() { echo "adr: $*" >&2; exit 1; }

new() {
  local slug=${1:-}
  [ -n "$slug" ] || die "usage: bin/adr new <slug>"
  [[ $slug =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || die "slug: lowercase words joined by -"

  local last n file title
  last=$(find "$dir" -maxdepth 1 -name '[0-9][0-9][0-9][0-9]-*.md' | sort | tail -1)
  if [ -n "$last" ]; then
    n=$((10#$(basename "$last" | cut -c1-4) + 1))
  else
    n=1
  fi
  n=$(printf '%04d' "$n")
  file=$dir/$n-$slug.md
  [ -e "$file" ] && die "$file exists"
  title=${slug//-/ }

  sed -e "s/^# NNNN\. .*/# $n. $title/" -e "s/^- Date: DATE/- Date: $(date +%F)/" \
    "$dir/template.md" > "$file"

  local row
  row="| [$n]($n-$slug.md) | $title | proposed | $(date +%F) |"
  awk -v row="$row" '
    /^\| \[/ { print; seen = 1; next }
    seen && !done { print row; done = 1 }
    { print }
    END { if (seen && !done) print row }
  ' "$readme" > "$readme.tmp"
  mv "$readme.tmp" "$readme"
  echo "$file"
}

check() {
  local files n prev=0 base status link
  files=$(find "$dir" -maxdepth 1 -name '[0-9][0-9][0-9][0-9]-*.md' | sort)
  [ -n "$files" ] || die "no records in $dir"

  for f in $files; do
    base=$(basename "$f")
    n=${base%%-*}

    [ $((10#$n)) -eq $((prev + 1)) ] || die "$base: expected number $(printf '%04d' $((prev + 1)))"
    prev=$((10#$n))

    grep -q "^# $n\. " "$f" || die "$base: title must start with '# $n. '"
    rows=$(grep -c "^| \[$n\]" "$readme" || true)
    [ "$rows" -eq 1 ] || die "$base: $rows rows in $readme, want exactly one"
    grep -q "^| \[$n\]($base)" "$readme" || die "$base: the row in $readme does not link to $base"

    status=$(sed -n 's/^- Status: //p' "$f")
    [[ $status =~ ^(proposed|accepted|rejected|deprecated)$ ]] ||
      [[ $status =~ ^superseded\ by\ [0-9]{4}$ ]] ||
      die "$base: status '$status'"

    link=$(sed -n 's/^- Superseded by: //p' "$f")
    # The index row repeats the record's title, status and date: a row that
    # drifted (a status left at "proposed", a retyped title) misleads the reader.
    local row rtitle rstatus rdate title date
    row=$(grep "^| \[$n\]" "$readme")
    IFS='|' read -r _ _ rtitle rstatus rdate _ <<<"$row"
    rtitle=$(sed 's/^ *//; s/ *$//' <<<"$rtitle")
    rstatus=$(sed 's/^ *//; s/ *$//' <<<"$rstatus")
    rdate=$(sed 's/^ *//; s/ *$//' <<<"$rdate")
    title=$(sed -n "1s/^# $n\\. //p" "$f")
    date=$(sed -n 's/^- Date: //p' "$f")
    [ "$rtitle" = "$title" ] || die "$base: the index says title '$rtitle', the record says '$title'"
    # A record whose header names its successor is superseded, whatever its
    # status line still says (the older records kept "accepted").
    local effective=$status successor
    successor=$(grep -o '[0-9]\{4\}' <<<"$link" | head -1 || true)
    [ -n "$successor" ] && effective="superseded by $successor"
    [ "$rstatus" = "$effective" ] || die "$base: the index says status '$rstatus', the record says '$effective'"
    [ "$rdate" = "$date" ] || die "$base: the index says date '$rdate', the record says '$date'"

    if [[ $status == superseded\ by\ * ]]; then
      [ "superseded by $link" = "$status" ] ||
        die "$base: status says '$status', header says '$link'"
      local target
      target=$(find "$dir" -maxdepth 1 -name "$link-*.md")
      [ -n "$target" ] || die "$base: superseded by $link, no such record"
      grep -q "^- Supersedes: $n$" "$target" ||
        die "$base: $link does not list '$n' in Supersedes"
    fi
  done

  echo "adr: ${prev} record(s) ok"
}

# set_row <number> <new status>: the status column of the index row.
set_row() {
  awk -v n="$1" -v st="$2" -F'|' -v OFS='|' '
    $0 ~ "^\\| \\[" n "\\]" { $4 = " " st " " }
    { print }
  ' "$readme" > "$readme.tmp"
  mv "$readme.tmp" "$readme"
}

record() { find "$dir" -maxdepth 1 -name "$1-*.md" | head -1; }

# accept <number>...: proposed -> accepted, in the record and in the index. A record that
# supersedes another one also marks the old one "superseded by", as the README asks.
accept() {
  [ $# -gt 0 ] || die "usage: bin/adr accept <number>..."
  local n f status old of
  for n in "$@"; do
    n=$(printf '%04d' "$((10#$n))")
    f=$(record "$n")
    [ -n "$f" ] || die "no record $n"
    status=$(sed -n 's/^- Status: //p' "$f")
    [ "$status" = proposed ] || die "$n is '$status', only a proposed record can be accepted"
    sed -i 's/^- Status: proposed$/- Status: accepted/' "$f"
    set_row "$n" accepted
    old=$(sed -n 's/^- Supersedes: //p' "$f" | grep -o '[0-9]\{4\}' | head -1 || true)
    if [ -n "$old" ]; then
      of=$(record "$old")
      [ -n "$of" ] || die "$n supersedes $old, no such record"
      sed -i -e "s/^- Status: .*/- Status: superseded by $n/" -e "s/^- Superseded by: .*/- Superseded by: $n/" "$of"
      set_row "$old" "superseded by $n"
      echo "adr: $old is now superseded by $n"
    fi
    echo "adr: $n accepted"
  done
  check
}

# proposed: the records still waiting for a decision.
proposed() {
  local f n
  for f in $(find "$dir" -maxdepth 1 -name '[0-9][0-9][0-9][0-9]-*.md' | sort); do
    [ "$(sed -n 's/^- Status: //p' "$f")" = proposed ] || continue
    n=$(basename "$f" | cut -c1-4)
    printf '%s  %s\n' "$n" "$(sed -n "1s/^# $n\\. //p" "$f")"
  done
}

case ${1:-check} in
  new) shift; new "$@" ;;
  check) check ;;
  accept) shift; accept "$@" ;;
  proposed) proposed ;;
  *) die "usage: bin/adr [new <slug>|check|accept <number>...|proposed]" ;;
esac
