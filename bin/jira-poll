#!/usr/bin/env bash
# Jira tickets as work items (ADR 0039, docs/sources-tracker.md). For each `PROJECT owner/repo`
# line of jira.list, ask the Jira REST search for the tickets updated lately and record each as
# a work item of that repository (bin/repos db ingest -source jira).
#
# Read only: it never comments on, transitions or assigns a ticket, and the agent is not
# involved. The credentials live in the environment, never in a file of this repository.
#
#   bin/jira-poll
#
# Environment:
#   JIRA_URL         the site, https://acme.atlassian.net (required)
#   JIRA_EMAIL       the account e-mail (required)
#   JIRA_API_TOKEN   an Atlassian API token (required)
#   JIRA_LOOKBACK    how far back to look, a JQL duration (default 7d)
#   JIRA_MAX         tickets per project and poll (default 100)
#   JIRA_LIST        lines "PROJECT owner/repo" (default jira.list, generated by `make repos`).
#                    No list, or one that lists nothing: exit 0.
#   REPOS_BIN        the repos binary (default bin/repos). STATE_DIR as everywhere.
#   JIRA_CURL        the curl command (default curl; tests put a fake in front).
#
# Exit codes: 0 when nothing is wrong or there is nothing to do, 1 when a project could not
# be fetched or recorded (the others are still done).
set -euo pipefail
cd "$(dirname "$0")/.."
root=$PWD
export STATE_DIR=${STATE_DIR:-$root/state}
list=${JIRA_LIST:-jira.list}
repos=${REPOS_BIN:-bin/repos}
curl_bin=${JIRA_CURL:-curl}
lookback=${JIRA_LOOKBACK:-7d}
max=${JIRA_MAX:-100}

if [ ! -f "$list" ]; then echo "jira-poll: no $list, nothing to poll"; exit 0; fi
command -v jq >/dev/null 2>&1 || { echo "jira-poll: jq is required" >&2; exit 1; }
[ -x "$repos" ] || { echo "jira-poll: $repos is missing, run \`make repos\` to build it" >&2; exit 1; }
for v in JIRA_URL JIRA_EMAIL JIRA_API_TOKEN; do
  [ -n "${!v:-}" ] || { echo "jira-poll: $v is not set" >&2; exit 1; }
done
case "$JIRA_URL" in https://*) ;; *) echo "jira-poll: JIRA_URL must start with https://" >&2; exit 1 ;; esac
[[ $lookback =~ ^[0-9]+[mhdw]$ ]] || { echo "jira-poll: JIRA_LOOKBACK must look like 7d" >&2; exit 1; }
[[ $max =~ ^[0-9]+$ ]] || { echo "jira-poll: JIRA_MAX must be a number" >&2; exit 1; }

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
mask() { sed -E 's#(://)[^/@[:space:]]*@#\1***@#g' | head -n 5; }

failed=0
while read -r project repo rest || [ -n "${project:-}" ]; do
  case "${project:-}" in ''|'#'*) continue ;; esac
  if [[ ! $project =~ ^[A-Z][A-Z0-9]+$ ]] || [[ ! ${repo:-} =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]]; then
    echo "jira-poll: skip invalid line: $project ${repo:-}" >&2
    continue
  fi
  jql="project = $project AND updated >= -$lookback ORDER BY updated DESC"
  rc=0
  # The credential goes to curl as a config on stdin, so it never shows in `ps`.
  printf 'user = "%s:%s"\n' "$JIRA_EMAIL" "$JIRA_API_TOKEN" | \
    "$curl_bin" -sS --fail-with-body --max-time 60 -K - -G "${JIRA_URL%/}/rest/api/3/search/jql" \
      --data-urlencode "jql=$jql" --data-urlencode "maxResults=$max" \
      --data-urlencode "fields=summary,description,issuetype,status,priority,labels,reporter,created,updated" \
      -H 'Accept: application/json' > "$tmp/search.json" 2> "$tmp/curl.err" || rc=$?
  if [ "$rc" != 0 ] || ! jq -e '.issues | type == "array"' "$tmp/search.json" >/dev/null 2>&1; then
    echo "jira-poll: $project: search failed (curl $rc): $(mask < "$tmp/curl.err")" >&2
    failed=1
    continue
  fi
  ingest() {
    "$repos" db ingest -dir "$root" -source jira -repo "$repo" -project "$project" -json \
      < "$tmp/search.json" > "$tmp/ingest.out" 2> "$tmp/ingest.err"
  }
  rc=0
  ingest || rc=$?
  if [ "$rc" != 0 ] && grep -q 'not a project' "$tmp/ingest.err" && [ -f "$root/repos.yaml" ]; then
    "$repos" db import -dir "$root" > /dev/null 2>&1 || true
    rc=0
    ingest || rc=$?
  fi
  if [ "$rc" != 0 ]; then
    echo "jira-poll: $project: could not record: $(mask < "$tmp/ingest.err")" >&2
    failed=1
    continue
  fi
  [ ! -s "$tmp/ingest.err" ] || echo "jira-poll: $project: $(mask < "$tmp/ingest.err")" >&2
  new=$(jq -rs '[.[] | select(.status == "new")] | length' "$tmp/ingest.out")
  changed=$(jq -rs '[.[] | select(.status == "changed")] | length' "$tmp/ingest.out")
  seen=$(jq -rs '[.[] | select(.status == "seen")] | length' "$tmp/ingest.out")
  echo "jira-poll: $project -> $repo: $new new, $changed changed, $seen seen"
done < "$list"
exit "$failed"
