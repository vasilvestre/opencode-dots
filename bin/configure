#!/usr/bin/env bash
# Choose, for each piece, whether the stack runs the local copy or the image
# copy. Writes .env and compose.override.yaml; nothing else reads the answers.
#
#   bin/configure                       ask on the terminal
#   bin/configure --opencode=local --gh=local --awf=docker --awf-gh=local
#   bin/configure --claude=local        also wire the claude CLI in (off by default)
#   bin/configure --root=/tmp/x --yes   write into another directory (tests)
set -euo pipefail

ROOT=$(cd "$(dirname "$0")/.." && pwd -P)
MODE_OPENCODE=local
MODE_AWF=docker
MODE_GH=local
MODE_AWFGH=docker
MODE_CLAUDE=off
ARG_OPENCODE=
ARG_AWF=
ARG_GH=
ARG_AWFGH=
ARG_CLAUDE=
ASSUME_YES=0
GIVEN=0

for arg in "$@"; do
  case "$arg" in
    --root=*) ROOT=${arg#*=} ;;
    --opencode=*) ARG_OPENCODE=${arg#*=}; GIVEN=1 ;;
    --awf=*) ARG_AWF=${arg#*=}; GIVEN=1 ;;
    --gh=*) ARG_GH=${arg#*=}; GIVEN=1 ;;
    --awf-gh=*) ARG_AWFGH=${arg#*=}; GIVEN=1 ;;
    --claude=*) ARG_CLAUDE=${arg#*=}; GIVEN=1 ;;
    -y|--yes) ASSUME_YES=1 ;;
    -h|--help) sed -n '2,7p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown flag: $arg" >&2; exit 2 ;;
  esac
done

# Keep the previous answers when the file already exists.
OLD_GH_TOKEN=
OLD_DISCORD_WEBHOOK=
if [ -f "$ROOT/.env" ]; then
  while IFS='=' read -r k v; do
    case "$k" in
      DOT_OPENCODE) [ -n "$v" ] && MODE_OPENCODE=$v ;;
      DOT_AWF) [ -n "$v" ] && MODE_AWF=$v ;;
      DOT_GH) [ -n "$v" ] && MODE_GH=$v ;;
      DOT_AWFGH) [ -n "$v" ] && MODE_AWFGH=$v ;;
      DOT_CLAUDE) [ -n "$v" ] && MODE_CLAUDE=$v ;;
      GH_TOKEN) OLD_GH_TOKEN=$v ;;
      DISCORD_WEBHOOK) OLD_DISCORD_WEBHOOK=$v ;;
    esac
  done < "$ROOT/.env"
fi

# A flag on the command line wins over the previous answer.
if [ -n "$ARG_OPENCODE" ]; then MODE_OPENCODE=$ARG_OPENCODE; fi
if [ -n "$ARG_AWF" ]; then MODE_AWF=$ARG_AWF; fi
if [ -n "$ARG_GH" ]; then MODE_GH=$ARG_GH; fi
if [ -n "$ARG_AWFGH" ]; then MODE_AWFGH=$ARG_AWFGH; fi
if [ -n "$ARG_CLAUDE" ]; then MODE_CLAUDE=$ARG_CLAUDE; fi

die() { echo "configure: $*" >&2; exit 1; }
require_local() { command -v "$1" >/dev/null 2>&1 || die "$1 is not on PATH, cannot use it locally"; }

ask() { # ask <var> <question> <default>
  local var=$1 question=$2 default=$3 answer=
  read -r -p "$question [$default]: " answer </dev/tty || true
  printf -v "$var" '%s' "${answer:-$default}"
}

if [ "$GIVEN" = 0 ] && [ "$ASSUME_YES" = 0 ] && [ -t 0 ]; then
  ask MODE_OPENCODE "opencode: local or docker" "$MODE_OPENCODE"
  ask MODE_AWF "awf: docker or local" "$MODE_AWF"
  ask MODE_GH "gh: local or docker" "$MODE_GH"
  ask MODE_AWFGH "awf-gh: docker or local" "$MODE_AWFGH"
  ask MODE_CLAUDE "claude: off, local or docker" "$MODE_CLAUDE"
fi

for m in "$MODE_OPENCODE" "$MODE_AWF" "$MODE_GH" "$MODE_AWFGH"; do
  case "$m" in local|docker) ;; *) die "modes take 'local' or 'docker', got '$m'" ;; esac
done
case "$MODE_CLAUDE" in off|local|docker) ;; *) die "--claude takes 'off', 'local' or 'docker', got '$MODE_CLAUDE'" ;; esac

# awf on the host calls the binary: it cannot reach an opencode container, and
# the host gh is the only one with the keyring.
if [ "$MODE_AWF" = local ]; then
  MODE_OPENCODE=local
  MODE_GH=local
  if [ "$MODE_CLAUDE" != off ]; then MODE_CLAUDE=local; fi
fi

# The native awf-gh shells out to gh on the host: same reason as above.
if [ "$MODE_AWFGH" = local ]; then
  MODE_GH=local
fi

# Say it once, where the choice is made.
if [ "$MODE_OPENCODE" = docker ] || [ "$MODE_AWF" = docker ] || [ "$MODE_GH" = docker ] ||
   [ "$MODE_AWFGH" = docker ] || [ "$MODE_CLAUDE" = docker ]; then
  echo "note: docker mode is experimental and not encouraged; local is the supported path" >&2
fi

OPENCODE_BIN=
OPENCODE_URL=
if [ "$MODE_OPENCODE" = local ]; then
  require_local opencode
  OPENCODE_BIN=$(readlink -f "$(command -v opencode)")
  service=$HOME/.local/state/opencode/service.json
  [ -f "$service" ] ||
    die "no running opencode service ($service missing); run 'opencode serve' or pick docker"
  OPENCODE_URL=$(sed -n 's/.*"url":"\([^"]*\)".*/\1/p' "$service")
fi

GH_BIN=
if [ "$MODE_GH" = local ]; then
  require_local gh
  GH_BIN=$(readlink -f "$(command -v gh)")
fi

CLAUDE_BIN=
if [ "$MODE_CLAUDE" = local ]; then
  require_local claude
  CLAUDE_BIN=$(readlink -f "$(command -v claude)")
fi

if [ "$MODE_AWF" = local ]; then
  require_local awf
fi

if [ "$MODE_AWFGH" = local ]; then
  [ -x "$ROOT/bin/awf-gh" ] || die "bin/awf-gh is missing: run 'make build' or pick docker"
fi

# The token still reaches the containers: a container cannot read the keyring,
# even when its gh binary is the host one.
TOKEN=${OLD_GH_TOKEN:-}
if [ -z "$TOKEN" ]; then
  TOKEN=$(gh auth token 2>/dev/null || true)
fi
[ -n "$TOKEN" ] || die "no gh token: log in with 'gh auth login'"

PROFILES=
if [ "$MODE_AWF" = docker ]; then PROFILES=awf-docker; fi
if [ "$MODE_OPENCODE" = docker ]; then PROFILES=${PROFILES:+$PROFILES,}opencode-docker; fi

AWF_URL=http://awf:2511
if [ "$MODE_OPENCODE" = local ] || [ "$MODE_AWF" = local ] || [ "$MODE_AWFGH" = local ]; then
  AWF_URL=http://127.0.0.1:2511
fi

mkdir -p "$ROOT/state"

{
  echo "# Written by bin/configure. Run 'make configure' again to change it."
  echo "DOT_OPENCODE=$MODE_OPENCODE"
  echo "DOT_AWF=$MODE_AWF"
  echo "DOT_GH=$MODE_GH"
  echo "DOT_AWFGH=$MODE_AWFGH"
  echo "DOT_CLAUDE=$MODE_CLAUDE"
  echo "COMPOSE_PROFILES=$PROFILES"
  echo "GH_TOKEN=$TOKEN"
  echo "DISCORD_WEBHOOK=$OLD_DISCORD_WEBHOOK"
} > "$ROOT/.env"

{
  echo "# Generated by bin/configure: opencode=$MODE_OPENCODE awf=$MODE_AWF gh=$MODE_GH awf-gh=$MODE_AWFGH claude=$MODE_CLAUDE"
  echo "services:"
  if [ "$MODE_AWF" = docker ]; then
    echo "  awf:"
    if [ "$MODE_OPENCODE" = local ]; then
      echo "    network_mode: host"
      echo "    ports: !reset []"
      # Host network: 0.0.0.0 would publish awf on the LAN.
      echo '    command: ["awf", "serve", "--host", "127.0.0.1", "--port", "2511", "--storage", "/state/awf"]'
      # The local opencode server runs on the host, so its cwd and the state
      # dir must be host paths. Same absolute path inside and outside.
      echo "    working_dir: $ROOT/state"
      echo "    environment:"
      echo "      STATE_DIR: $ROOT/state"
    fi
    if [ "$MODE_OPENCODE" = local ] || [ "$MODE_GH" = local ] || [ "$MODE_CLAUDE" = local ]; then
      echo "    volumes:"
      if [ "$MODE_OPENCODE" = local ]; then
        echo "      - $ROOT/state:$ROOT/state"
        echo "      - $OPENCODE_BIN:/home/agent/.opencode/bin/opencode:ro"
        echo "      - $HOME/.config/opencode:/home/agent/.config/opencode"
        echo "      - $HOME/.local/share/opencode:/home/agent/.local/share/opencode"
        echo "      - $HOME/.local/state/opencode:/home/agent/.local/state/opencode"
      fi
      if [ "$MODE_GH" = local ]; then
        echo "      - $GH_BIN:/opt/agent/bin/gh:ro"
      fi
      if [ "$MODE_CLAUDE" = local ]; then
        echo "      - $CLAUDE_BIN:/opt/agent/bin/claude:ro"
        # Read-write: credentials and session state refresh under here.
        echo "      - $HOME/.claude:/home/agent/.claude"
      fi
    fi
  fi
  echo "  awf-gh:"
  if [ "$MODE_OPENCODE" = local ] || [ "$MODE_AWF" = local ]; then
    echo "    network_mode: host"
  fi
  if [ "$MODE_GH" = local ] || [ "$MODE_CLAUDE" = local ]; then
    echo "    volumes:"
    if [ "$MODE_GH" = local ]; then
      echo "      - $GH_BIN:/opt/agent/bin/gh:ro"
    fi
    if [ "$MODE_CLAUDE" = local ]; then
      echo "      - $CLAUDE_BIN:/opt/agent/bin/claude:ro"
      echo "      - $HOME/.claude:/home/agent/.claude"
    fi
  fi
} > "$ROOT/compose.override.yaml"

# awf-gh reads awf_url and state_path from its own config, which names private
# repos. The native binary sees host paths; the container sees /state.
STATE_PATH=/state/awf-gh/seen.jsonl
if [ "$MODE_AWFGH" = local ]; then STATE_PATH=$ROOT/state/awf-gh/seen.jsonl; fi
if [ -f "$ROOT/repos.yaml" ]; then
  # repos.yaml is the source: regenerate the watcher config with the values that
  # fit this mode instead of patching the generated file.
  command -v go >/dev/null || die "repos.yaml needs go to generate awf-gh.yaml (make repos)"
  (cd "$ROOT" && go run ./cmd/repos generate -awf-url "$AWF_URL" -state-path "$STATE_PATH")
elif [ -f "$ROOT/awf-gh.yaml" ]; then
  sed -i -e "s|^awf_url:.*|awf_url: $AWF_URL|" \
    -e "s|^state_path:.*|state_path: $STATE_PATH|" "$ROOT/awf-gh.yaml"
fi

echo "opencode: $MODE_OPENCODE${OPENCODE_URL:+ ($OPENCODE_URL)}"
echo "awf:      $MODE_AWF"
echo "gh:       $MODE_GH"
echo "awf-gh:   $MODE_AWFGH"
echo "claude:   $MODE_CLAUDE"
echo "awf_url:  $AWF_URL"
if [ "$MODE_AWF" = local ]; then echo "start awf yourself: awf serve"; fi
if [ "$MODE_AWFGH" = local ]; then
  echo "awf-gh native: see 'Run everything natively' in README.md (own config, timer drop-in)"
fi
if [ "$MODE_OPENCODE" = docker ] || [ "$MODE_AWF" = docker ] || [ "$MODE_GH" = docker ] ||
   [ "$MODE_AWFGH" = docker ]; then
  echo "next: make up"
fi
