#!/usr/bin/env bash
# Every cell of the publish-gate rules (ADR 0040). No network, no repository.
#
#   bin/test-publish-gate
set -uo pipefail
cd "$(dirname "$0")/.."
gate=$PWD/bin/publish-gate
state=$(mktemp -d)
trap 'rm -rf "$state"' EXIT
fail=0

# check AUTONOMY CLASS ACTION WANT
check() {
  local got
  rm -rf "$state/held" "$state/notes"
  AUTONOMY=$1 ITEM_CLASS=$2 STATE_DIR=$state GATE_REF=o/r#1 GATE_ARTIFACT=/x \
    GATE_PR_AUTHOR=${AUTHOR-me} DOT_LOGIN=me GATE_MERGE_SCOPE=${SCOPE:-} "$gate" "$3" 2>"$state/err"
  got=$?
  if [ "$got" != "$4" ]; then
    echo "FAIL autonomy='$1' class='$2' $3: want $4, got $got"
    fail=1
  fi
  [ -s "$state/err" ] || { echo "FAIL autonomy='$1' class='$2' $3: no reason on stderr"; fail=1; }
  case $4 in
    3) [ -n "$(ls "$state/held" 2>/dev/null)" ] || { echo "FAIL $1/$2/$3: nothing under held/"; fail=1; } ;;
    4) [ -n "$(ls "$state/notes" 2>/dev/null)" ] || { echo "FAIL $1/$2/$3: nothing under notes/"; fail=1; } ;;
    *) [ -z "$(ls "$state/held" "$state/notes" 2>/dev/null)" ] || { echo "FAIL $1/$2/$3: unexpected file"; fail=1; } ;;
  esac
}

actions="comment push open-pr merge"

# Legacy: empty autonomy allows everything, whatever the class.
for c in "" 1 2 3; do for a in $actions; do check "" "$c" "$a" 0; done; done

# observe: a note for everything.
for c in "" 1 2 3; do for a in $actions; do check observe "$c" "$a" 4; done; done

# propose: hold, a merge is refused; class 3 is a note.
for c in "" 1 2; do
  for a in comment push open-pr; do check propose "$c" "$a" 3; done
  check propose "$c" merge 5
done
for a in $actions; do check propose 3 "$a" 4; done

# act: allow, never merge; class 3 is a note.
for c in "" 1 2; do
  for a in comment push open-pr; do check act "$c" "$a" 0; done
  check act "$c" merge 5
done
for a in $actions; do check act 3 "$a" 4; done

# auto: allow; merge only for class 1 or unclassified, the dot's own pull request (default author "me" is the dot); class 2 never merges; class 3 is a note.
for c in "" 1 2; do for a in comment push open-pr; do check auto "$c" "$a" 0; done; done
check auto "" merge 0
check auto 1 merge 0
check auto 2 merge 5
for a in $actions; do check auto 3 "$a" 4; done

# Merge scope (ADR 0040): the dot's own and dependency bots by default, others refused.
for au in me dependabot[bot] renovate[bot] github-actions[bot] app/dependabot app/renovate; do
  AUTHOR=$au check auto 1 merge 0
done
for au in alice someone[bot] app/other dependabot-fake "" ; do
  AUTHOR=$au check auto 1 merge 5
  AUTHOR=$au SCOPE=own check auto "" merge 5
  AUTHOR=$au SCOPE=all check auto 1 merge 0
done
SCOPE=all AUTHOR=alice check auto 2 merge 5
SCOPE=all AUTHOR=alice check act 1 merge 5
SCOPE=all AUTHOR=alice check propose 1 merge 5
SCOPE=all AUTHOR=alice check auto 3 merge 4
SCOPE=bogus AUTHOR=me check auto 1 merge 5
AUTHOR=alice check auto 1 comment 0
AUTHOR=alice check auto 1 push 0
AUTONOMY=auto STATE_DIR=$state GATE_REF=o/r#1 GATE_PR_AUTHOR=alice DOT_LOGIN=me "$gate" merge 2>"$state/err"
grep -q 'alice wrote it' "$state/err" || { echo "FAIL merge scope not explained on stderr"; fail=1; }

# Circuit breaker: a file for the repository lowers auto to act, nothing else changes.
mkdir -p "$state/breaker"
echo '{}' > "$state/breaker/o__r.json"
for a in comment push open-pr; do check auto 1 "$a" 0; done
check auto 1 merge 5
check auto "" merge 5
check auto 3 comment 4
check propose 1 comment 3
check "" 1 merge 0
AUTONOMY=auto STATE_DIR=$state GATE_REF=o/r#1 "$gate" merge 2>"$state/err"
grep -q 'circuit breaker tripped for o/r' "$state/err" || { echo "FAIL breaker not explained on stderr"; fail=1; }
# GATE_REPO wins over GATE_REF; another repository is untouched.
AUTONOMY=auto STATE_DIR=$state GATE_REF=x/y#1 GATE_REPO=o/r "$gate" merge 2>/dev/null
[ $? = 5 ] || { echo "FAIL GATE_REPO ignored"; fail=1; }
AUTONOMY=auto STATE_DIR=$state GATE_PR_AUTHOR=me DOT_LOGIN=me GATE_REF=x/y#1 "$gate" merge 2>/dev/null
[ $? = 0 ] || { echo "FAIL breaker leaked to another repository"; fail=1; }
AUTONOMY=auto STATE_DIR=$state GATE_PR_AUTHOR=me DOT_LOGIN=me GATE_REF=unknown "$gate" merge 2>/dev/null
[ $? = 0 ] || { echo "FAIL breaker applied without a repository"; fail=1; }
rm -rf "$state/breaker"

# file-issue (ADR 0043): auto allows, propose holds, observe notes, act refuses.
check "" "" file-issue 0
check auto "" file-issue 0
check propose "" file-issue 3
check observe "" file-issue 4
check act "" file-issue 5
check auto 3 file-issue 4
AUTONOMY=act STATE_DIR=$state GATE_REF=up/tool "$gate" file-issue 2>"$state/err"
grep -q 'writing on an upstream tracker needs auto' "$state/err" || { echo "FAIL file-issue act reason"; fail=1; }
rm -rf "$state/held"
AUTONOMY=propose STATE_DIR=$state GATE_REF=up/tool GATE_ARTIFACT=/x/issue.md GATE_TITLE="A title" GATE_TARGET=up/tool "$gate" file-issue 2>/dev/null
f=$(ls "$state"/held/*file-issue*.txt)
grep -qx 'target: up/tool' "$f" && grep -qx 'title: A title' "$f" && grep -qx 'artifact: /x/issue.md' "$f" || { echo "FAIL file-issue held record"; fail=1; }
# A tripped breaker on the dot's own repository lowers auto to act: refused.
mkdir -p "$state/breaker"; echo '{}' > "$state/breaker/o__r.json"
AUTONOMY=auto STATE_DIR=$state GATE_REF=up/tool GATE_REPO=o/r "$gate" file-issue 2>/dev/null
[ $? = 5 ] || { echo "FAIL file-issue allowed with a tripped breaker"; fail=1; }
rm -rf "$state/breaker" "$state/held"

# Bad input is refused, never allowed.
check bogus 1 comment 5
check auto 9 comment 5
check auto 1 delete 5
check auto 1 "" 5

# A held item names its artifact.
rm -rf "$state/held"
AUTONOMY=propose STATE_DIR=$state GATE_REF=o/r#7 GATE_ARTIFACT=/x/fix.patch "$gate" push 2>/dev/null
grep -q 'artifact: /x/fix.patch' "$state"/held/*push* || { echo "FAIL held file lacks the artifact"; fail=1; }

# A held record carries the optional release lines, cleaned; unset ones are omitted.
rm -rf "$state/held"
AUTONOMY=propose STATE_DIR=$state GATE_REF=o/r#7 GATE_ARTIFACT=/x/fix.patch GATE_BRANCH=fix/7-x GATE_BASE=main \
  GATE_PUSH_REPO=me/r GATE_TITLE=$'Fix it\x01 now\nsecond line' GATE_CLOSES=7 "$gate" push 2>/dev/null
f=$(ls "$state"/held/*push*)
for l in 'branch: fix/7-x' 'base: main' 'push-repo: me/r' 'title: Fix it now' 'closes: 7'; do
  grep -qx "$l" "$f" || { echo "FAIL held record lacks '$l'"; fail=1; }
done
[ "$(grep -c . "$f")" = 11 ] || { echo "FAIL held record has stray lines"; fail=1; }
rm -rf "$state/held"
AUTONOMY=propose STATE_DIR=$state GATE_REF=o/r#7 GATE_ARTIFACT=/x/fix.patch GATE_BRANCH=b "$gate" open-pr 2>/dev/null
f=$(ls "$state"/held/*open-pr*)
grep -qx 'branch: b' "$f" || { echo "FAIL partial record lacks branch"; fail=1; }
! grep -Eq '^(base|push-repo|title|closes):' "$f" || { echo "FAIL unset field written"; fail=1; }
# A note never carries them.
rm -rf "$state/notes"
AUTONOMY=observe STATE_DIR=$state GATE_REF=o/r#7 GATE_BRANCH=b "$gate" push 2>/dev/null
! grep -q '^branch:' "$state"/notes/* || { echo "FAIL note carries branch"; fail=1; }

# A held or note record keeps its own copy of the artifact (D3): the original can go.
rm -rf "$state/held" "$state/notes"
mkdir -p "$state/src"
printf 'the patch\n' > "$state/src/held.patch"
AUTONOMY=propose STATE_DIR=$state GATE_REF=o/r#7 GATE_ARTIFACT=$state/src/held.patch "$gate" push 2>/dev/null
f=$(ls "$state"/held/*push*.txt)
cp_path=$(sed -n 's/^artifact: //p' "$f")
case "$cp_path" in "$state"/held/artifacts/*/held.patch) ;; *) echo "FAIL held artifact not under held/artifacts: $cp_path"; fail=1 ;; esac
grep -qx "source: $state/src/held.patch" "$f" || { echo "FAIL held record lacks the source line"; fail=1; }
rm -rf "$state/src"
[ "$(cat "$cp_path" 2>/dev/null)" = "the patch" ] || { echo "FAIL the copy does not survive its source"; fail=1; }
[ "$(ls "$state/held" | grep -c -v '^artifacts$')" = 1 ] || { echo "FAIL held/ holds more than the record and artifacts/"; fail=1; }
# A note copies too, under notes/artifacts.
rm -rf "$state/notes"
mkdir -p "$state/src"; printf 'text\n' > "$state/src/answer.md"
AUTONOMY=observe STATE_DIR=$state GATE_REF=o/r#7 GATE_ARTIFACT=$state/src/answer.md "$gate" comment 2>/dev/null
grep -q "^artifact: $state/notes/artifacts/.*/answer.md$" "$state"/notes/*comment*.txt || { echo "FAIL note artifact not copied"; fail=1; }
# Over the cap, a missing or an empty artifact: no copy, the original path stays, no source line.
rm -rf "$state/held"
AUTONOMY=propose STATE_DIR=$state GATE_ARTIFACT_CAP=3 GATE_REF=o/r#7 GATE_ARTIFACT=$state/src/answer.md "$gate" comment 2>/dev/null
f=$(ls "$state"/held/*comment*.txt)
grep -qx "artifact: $state/src/answer.md" "$f" && ! grep -q '^source:' "$f" && [ ! -e "$state/held/artifacts" ] \
  || { echo "FAIL over-cap artifact was copied"; fail=1; }
: > "$state/src/empty.md"
for a in "$state/src/empty.md" "$state/src/nope.md" /x; do
  rm -rf "$state/held"
  AUTONOMY=propose STATE_DIR=$state GATE_REF=o/r#7 GATE_ARTIFACT=$a "$gate" comment 2>/dev/null
  f=$(ls "$state"/held/*comment*.txt)
  { grep -qx "artifact: $a" "$f" && ! grep -q '^source:' "$f"; } || { echo "FAIL $a: record changed"; fail=1; }
done
# Legacy writes nothing.
rm -rf "$state/held" "$state/notes"
STATE_DIR=$state GATE_REF=o/r#7 GATE_ARTIFACT=$state/src/answer.md "$gate" comment 2>/dev/null
[ ! -e "$state/held" ] && [ ! -e "$state/notes" ] || { echo "FAIL legacy wrote a record"; fail=1; }

# Identity (ADR 0034): the dot's login is not enough once marking is on.
merge_id() { # IDENTITY MARKED AUTHOR SCOPE WANT
  local got
  AUTONOMY=auto STATE_DIR=$state GATE_REF=o/r#1 GATE_ARTIFACT=/x GATE_PR_AUTHOR=$3 DOT_LOGIN=me \
    GATE_MERGE_SCOPE=$4 GATE_IDENTITY=$1 GATE_PR_BODY_MARKED=$2 "$gate" merge 2>"$state/err"
  got=$?
  [ "$got" = "$5" ] || { echo "FAIL merge identity='$1' marked='$2' author=$3 scope='$4': want $5, got $got"; fail=1; }
}
for id in "" off; do for m in "" 0 1; do merge_id "$id" "$m" me "" 0; done; done      # marking off: as before
for id in marker signed; do
  merge_id $id 1 me "" 0          # the dot's own, marked
  merge_id $id "" me "" 5         # same login, no marker: a human's
  merge_id $id 0 me "" 5
  merge_id $id 0 me all 0         # the owner widened the scope
  merge_id $id 0 stranger "" 5    # unchanged
  merge_id $id 0 'dependabot[bot]' "" 0   # a dependency bot needs no marker
  merge_id $id 1 stranger "" 5    # a marker does not make someone else's the dot's
done
merge_id bogus 1 me "" 5
AUTONOMY=auto STATE_DIR=$state GATE_REF=o/r#1 GATE_PR_AUTHOR=me DOT_LOGIN=me GATE_IDENTITY=marker "$gate" merge 2>"$state/err"
grep -q 'no dot marker' "$state/err" || { echo "FAIL the refusal does not name the missing marker"; fail=1; }
# Marking never touches the other actions.
for a in comment push open-pr; do
  AUTONOMY=auto STATE_DIR=$state GATE_REF=o/r#1 GATE_IDENTITY=signed "$gate" $a 2>/dev/null || { echo "FAIL $a changed by identity"; fail=1; }
done

# A held file-issue record carries repo: and upstream:.
rm -rf "$state/held"
AUTONOMY=propose STATE_DIR=$state GATE_REF=up/tool GATE_ARTIFACT=/x GATE_TARGET=up/tool GATE_REPO_SOURCE=o/r GATE_UPSTREAM=up/tool \
  "$gate" file-issue 2>/dev/null
f=$(ls "$state"/held/*file-issue*)
for l in 'target: up/tool' 'repo: o/r' 'upstream: up/tool'; do
  grep -qx "$l" "$f" || { echo "FAIL file-issue record lacks '$l'"; fail=1; }
done
rm -rf "$state/held"
AUTONOMY=propose STATE_DIR=$state GATE_REF=up/tool GATE_ARTIFACT=/x "$gate" file-issue 2>/dev/null
! grep -Eq '^(repo|upstream):' "$state"/held/*file-issue* || { echo "FAIL unset repo/upstream written"; fail=1; }

# An unwritable state dir never turns a hold into an allow.
AUTONOMY=propose STATE_DIR=/proc/nope GATE_REF=o/r#7 "$gate" comment 2>/dev/null
[ $? = 3 ] || { echo "FAIL unwritable state dir changed the exit code"; fail=1; }

if [ "$fail" = 0 ]; then echo "publish-gate: all cells pass"; fi
exit "$fail"
