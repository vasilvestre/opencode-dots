# Copy to .env, then fill both values. .env is gitignored.
# gh stores its token in the host keyring, a container cannot read it.
# Get it with: gh auth token
GH_TOKEN=
# Discord channel webhook, used by the workflows to announce a posted review or
# reply. Leave empty to turn notifications off. Channel settings, Integrations,
# Webhooks, New Webhook, Copy Webhook URL.
DISCORD_WEBHOOK=
