# `make configure` writes .env for you from your answers. This file only shows
# what it can contain; copy it by hand if you prefer.
#
# Which piece runs locally and which runs in an image.
DOT_OPENCODE=local
DOT_AWF=docker
DOT_GH=local
# Enables the image services that the modes select (awf-docker, opencode-docker).
COMPOSE_PROFILES=awf-docker
# gh stores its token in the host keyring, a container cannot read it, so the
# token still travels in .env even when gh runs from the host binary.
# Get it with: gh auth token
GH_TOKEN=
# Where the review and fix workflows keep their clones
# (default: $STATE_DIR/work). Keep it under STATE_DIR unless you also mount it:
# a local opencode server only reads host paths.
WORK_ROOT=
# Discord channel webhook, used by the workflows to announce a posted review or
# reply. Leave empty to turn notifications off. Channel settings, Integrations,
# Webhooks, New Webhook, Copy Webhook URL.
DISCORD_WEBHOOK=
# Models to try, in order, when a run fails on a quota or a rate limit (bin/shim/opencode).
# Comma separated provider/model ids. Empty: no fallback.
DOTS_MODEL_FALLBACKS=
# 1 runs each opencode step on a private server that stops with the step (opencode run --standalone),
# so what a run loaded is freed and memory does not pile up. Empty: use the background service.
DOTS_OPENCODE_STANDALONE=
