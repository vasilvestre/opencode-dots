bin/*
node_modules/
# `make dashboard` and `go build ./cmd/dashboard` write the binary here.
/dashboard
state/
.tower/
.env
compose.override.yaml
# repos.yaml is the one local list of repositories (copy repos.example.yaml); the
# files below are generated from it by `make repos`. This repo is public, the
# names are not.
repos.yaml
awf-gh.yaml
awf-gh.*.yaml
!awf-gh.*.example.yaml
repos.map
sync.map
tend.list
# The round trip fixtures of internal/repos carry the same names, with fake repos.
!internal/repos/testdata/*
!bin/adr
!bin/configure
!bin/sync
!bin/tend
!bin/remote
!bin/backup-server
# Machine-specific dashboard settings: copy the .example and fill it in.
# Local, gitignored: the tailnet name of this machine is not public.
systemd/dots-dashboard.env
# Local Discord webhook, editable from the dashboard Config page.
notifications.json
notifications.json.*.bak
# /api/save backups (ADR 0004), pruned to the last twenty per file at runtime.
*.*.[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9][0-9][0-9].bak
# OpenTofu: variables, state and provider cache stay local (ADR 0028).
*.tfvars
!*.tfvars.example
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
