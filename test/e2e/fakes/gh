#!/usr/bin/env bash
# Fake gh for test/e2e. Every call is appended to $FAKE_DIR/gh.log. Read calls
# are answered from canned files under $FAKE_DIR/gh; publishing calls only log
# (the body files they are given are copied to $FAKE_DIR/posted/). It never
# touches the network and knows no credentials.
set -u
: "${FAKE_DIR:?FAKE_DIR not set}"
g=$FAKE_DIR/gh
echo "gh $*" >> "$FAKE_DIR/gh.log"

jqx=""
bodyfile=""
repo=""
search=""
limit=""
args=("$@")
for ((i = 0; i < ${#args[@]}; i++)); do
  case "${args[i]}" in
    --jq) jqx=${args[i+1]:-} ;;
    --body-file) bodyfile=${args[i+1]:-} ;;
    --repo) repo=${args[i+1]:-} ;;
    --search) search=${args[i+1]:-} ;;
    --limit) limit=${args[i+1]:-} ;;
  esac
done

emit() { # FILE: print the canned JSON, through --jq when given
  [ -f "$1" ] || { echo "fake gh: no canned file $1" >&2; exit 1; }
  if [ -n "$jqx" ]; then jq -r "$jqx" "$1"; else cat "$1"; fi
}
snap() { # KIND: keep what a publishing call was given
  mkdir -p "$FAKE_DIR/posted"
  local n
  n=$(find "$FAKE_DIR/posted" -type f | wc -l)
  if [ -n "$bodyfile" ] && [ -f "$bodyfile" ]; then
    cp "$bodyfile" "$FAKE_DIR/posted/$(printf %03d "$n")-$1.md"
  fi
  return 0
}

case "${1:-} ${2:-}" in
  "auth setup-git") exit 0 ;;
  "api user")
    case "$*" in *.id*) echo 4242 ;; *) cat "$g/login" ;; esac ;;
  "api repos/"*"/commits"*) # tend-repo survey: the commit list, canned or empty
    if [ -f "$g/commits.json" ]; then emit "$g/commits.json"; else echo '[]'; fi ;;
  "api repos/"*"/pulls/"*) # the live head of a pull request, from pr-N.json
    n=${2##*/pulls/}
    jq -n --arg s "$(jq -r .headRefOid "$g/pr-$n.json")" '{head:{sha:$s}}' > "$g/.pull-$n.json"
    emit "$g/.pull-$n.json" ;;
  "api repos/"*)
    p=${2#repos/}
    if [ -f "$g/repo-${p//\//_}.json" ]; then
      emit "$g/repo-${p//\//_}.json"
    elif [ -f "$g/repo.json" ] && [ "$p" = "$(jq -r .full_name "$g/repo.json")" ]; then
      emit "$g/repo.json"
    else
      echo "gh: Not Found (HTTP 404)" >&2
      exit 1
    fi ;;
  "repo view") emit "$g/repo.json" ;;
  "repo fork") echo "fake gh: repo fork is not expected in e2e" >&2; exit 1 ;;
  "issue view")
    # An upstream issue the case canned (up-issue-<owner_repo>-<N>.json) wins over issue.json.
    uf=$g/up-issue-${repo//\//_}-$3.json
    if [ -n "$repo" ] && [ -f "$uf" ]; then emit "$uf"; else emit "$g/issue.json"; fi ;;
  "issue list")
    # up-list-fail-<slug> makes the call fail. up-issues-<slug>.json is the tracker, newest
    # first. --search keeps only the issues whose title and body hold EVERY word of the
    # query (as GitHub does); --limit then cuts the list.
    slug=${repo//\//_}
    [ ! -f "$g/up-list-fail-$slug" ] || { echo "gh: HTTP 502" >&2; exit 1; }
    if [ -f "$g/up-issues-$slug.json" ]; then
      jq --arg q "$search" --argjson n "${limit:-1000}" '
        ($q | ascii_downcase | [scan("[^ ]+")]) as $w
        | [.[] | select((((.title + " " + .body) | ascii_downcase) as $t | all($w[]; . as $x | $t | contains($x))))]
        | .[:$n]' "$g/up-issues-$slug.json" > "$g/.list-cut.json" 2>/dev/null || cp "$g/up-issues-$slug.json" "$g/.list-cut.json"
      emit "$g/.list-cut.json"
    elif [ -f "$g/issues-list.json" ]; then emit "$g/issues-list.json"; else echo '[]'; fi ;;
  "issue create") snap issue-create; echo "https://github.com/${repo:-x/y}/issues/${FAKE_ISSUE_N:-101}" ;;
  "pr list") if [ -f "$g/pr-list.json" ]; then emit "$g/pr-list.json"; else echo '[]'; fi ;;
  "issue comment") snap issue-comment ;;
  "pr view") emit "$g/pr-$3.json" ;;
  "pr diff") cat "$g/diff.patch" ;;
  "pr checks") if [ -f "$g/checks.json" ]; then cat "$g/checks.json"; else echo '[]'; fi ;;
  "pr comment") snap pr-comment ;;
  "pr create") snap pr-create; echo "https://github.com/${repo:-x/y}/pull/99" ;;
  "pr merge") exit 0 ;;
  "run view") exit 0 ;;
  *) echo "fake gh: unhandled call: $*" >&2; echo "UNHANDLED gh $*" >> "$FAKE_DIR/gh.log"; exit 1 ;;
esac
