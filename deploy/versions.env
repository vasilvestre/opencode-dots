# Versions the bootstrap installs (ADR 0028). Change them here, in a diff.
# awf v0.12.0 is the first release that can preflight opencode v2.
AWF_VERSION=v0.12.0
# The default installer URL installs opencode 1.x; the v2 installer is another URL.
OPENCODE_INSTALL_URL=https://opencode.ai/v2/install
OPENCODE_MAJOR=2
# The repository the user step clones, and the directory it goes in.
DOTS_REPO_DEFAULT=https://github.com/vasilvestre/opencode-dots
